---
import "../style/global.css";
import { Icon } from "astro-icon/components";

// ==========================================
// CONFIGURACIÓN DE CONTENIDO (FÁCIL EDICIÓN)
// ==========================================

const siteConfig = {
  name: "DREAM PROJECTS STUDIO",
  subtitle: "ROBLOX GAME STUDIO",
  description: "Estudio profesional de desarrollo en Roblox. Ofrecemos servicios corporativos de creación de juegos y reclutamos talento técnico con experiencia comprobada.",
};

// Enlaces de navegación superior
const navLinks = [
  { name: "Nosotros", href: "#nosotros" },
  { name: "Servicios B2B", href: "#servicios" },
  { name: "Empleo", href: "#areas" },
  { name: "Requisitos", href: "#requisitos" },
  { name: "Proceso", href: "#proceso" },
];

// Servicios ofrecidos para empresas (B2B)
const servicesData = [
  {
    title: "Experiencias y Juegos a Medida",
    description: "Creamos mundos, simuladores y activaciones interactivas personalizadas dentro de Roblox para marcas y empresas.",
    icon: "lucide:gamepad-2",
    badge: "Corporativo"
  },
  {
    title: "Programación en Luau Avanzado",
    description: "Desarrollo de lógica compleja, optimización de rendimiento, sistemas de guardado y conexión con APIs externas.",
    icon: "lucide:code-2",
    badge: "Técnico"
  },
  {
    title: "Diseño de Mundos y Mapas 3D",
    description: "Construcción de escenarios inmersivos, optimización de mallas y diseño visual con identidad propia.",
    icon: "lucide:mountain",
    badge: "Visual"
  }
];

// Áreas de contratación (Exige experiencia y compromiso)
const hiringAreas = [
  {
    title: "Scripting (Luau)",
    description: "Programación de sistemas de juego, interfaces funcionales y lógica de alta eficiencia en Roblox Studio.",
    icon: "lucide:code-2",
    iconBg: "bg-orange-500/10",
    iconColor: "text-orange-400",
    tag: "Nivel Medio/Alto",
    requirement: "Experiencia demostrable y portafolio activo."
  },
  {
    title: "Building / Mapas",
    description: "Construcción de entornos detallados, manejo de iluminación y optimización de rendimiento para experiencias fluidas.",
    icon: "lucide:mountain",
    iconBg: "bg-emerald-500/10",
    iconColor: "text-emerald-400",
    tag: "Nivel Medio",
    requirement: "Dominio de Roblox Studio y modelado básico."
  },
  {
    title: "UI/UX & Modelado 3D",
    description: "Diseño de interfaces limpias (HUDs, menús, tiendas) y recursos visuales adaptados a la plataforma.",
    icon: "lucide:palette",
    iconBg: "bg-purple-500/10",
    iconColor: "text-purple-400",
    tag: "Nivel Medio",
    requirement: "Experiencia previa requerida."
  }
];

// Requisitos indispensables (Compromiso y experiencia)
const requirementsData = [
  {
    title: "Experiencia previa comprobable",
    description: "No aceptamos perfiles desde cero (0 base). Requerimos que ya domines tu área de trabajo y tengas proyectos previos.",
    icon: "lucide:check-circle-2"
  },
  {
    title: "Compromiso y responsabilidad real",
    description: "Buscamos personas serias que cumplan con los plazos acordados y mantengan una comunicación constante.",
    icon: "lucide:calendar-check"
  },
  {
    title: "Trabajo en equipo profesional",
    description: "Capacidad para aceptar retroalimentación constructiva y colaborar activamente en proyectos complejos.",
    icon: "lucide:handshake"
  }
];

// Pasos del proceso
const processSteps = [
  {
    step: "01",
    title: "Contacto inicial",
    description: "Únete a nuestro canal de comunicación o escríbenos para detallar si buscas servicios o postularte."
  },
  {
    step: "02",
    title: "Evaluación de perfil",
    description: "Revisamos tu portafolio técnico (si buscas empleo) o las necesidades de tu empresa (si buscas servicios)."
  },
  {
    step: "03",
    title: "¡Manos a la obra!",
    description: "Definimos los objetivos, plazos y comenzamos a construir el proyecto de manera profesional."
  }
];
---

<!doctype html>
<html lang="es">
  <head>



      <title>DREAM PROJECTS STUDIO</title>




<title>DREAM PROJECTS STUDIO | Roblox Game Development</title>
<meta name="description" content="Creamos experiencias y videojuegos en Roblox para marcas, empresas y comunidades." />

<meta name="robots" content="index, follow" />
<link rel="canonical" href="https://dreamprojectsstudio.nanadev.online/" />

<!-- Open Graph: Discord y otras plataformas -->
<meta property="og:title" content="DREAM PROJECTS STUDIO | Roblox Game Development" />
<meta property="og:description" content="Creamos experiencias y videojuegos en Roblox para marcas, empresas y comunidades." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://dreamprojectsstudio.nanadev.online/" />
<meta property="og:image" content="https://dreamprojectsstudio.nanadev.online/logo.webp" />
<meta property="og:image:alt" content="Logo de DREAM PROJECTS STUDIO" />
<meta property="og:site_name" content="DREAM PROJECTS STUDIO" />
<meta property="og:locale" content="es_CO" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="DREAM PROJECTS STUDIO | Roblox Game Development" />
<meta name="twitter:description" content="Creamos experiencias y videojuegos en Roblox para marcas, empresas y comunidades." />
<meta name="twitter:image" content="https://dreamprojectsstudio.nanadev.online/logo.webp" />
<meta name="twitter:image:alt" content="Logo de DREAM PROJECTS STUDIO" />







    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <meta name="generator" content={Astro.generator} />

    <title>{siteConfig.name} | Desarrollo de Juegos & Servicios B2B</title>

    <meta name="description" content={siteConfig.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased selection:bg-red-500 selection:text-white">

    <!-- Navegación -->
    <header class="sticky top-0 z-50 border-b border-white/5 bg-zinc-950/85 backdrop-blur-xl">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">

        <a href="#inicio" class="group flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-red-500/20 bg-red-500/10 text-red-400 transition group-hover:bg-red-500/20">
            <Icon name="lucide:rat" class="h-6 w-6" />
          </div>
          <div>
            <span class="block text-sm font-extrabold tracking-tight text-white">{siteConfig.name}</span>
            <span class="block text-[10px] tracking-[0.2em] text-zinc-500">{siteConfig.subtitle}</span>
          </div>
        </a>

        <div class="hidden items-center gap-7 text-sm text-zinc-400 md:flex">
          {navLinks.map((link) => (
            <a href={link.href} class="transition hover:text-white">{link.name}</a>
          ))}
        </div>

        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-500"
        >
          Iniciar Proyecto / Unirse
          <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
        </a>

      </nav>
    </header>

    <main id="inicio">

      <!-- Hero -->
      <section class="relative isolate overflow-hidden">
        <div class="pointer-events-none absolute inset-0 -z-10">
          <div class="absolute left-1/2 top-0 h-[420px] w-[720px] -translate-x-1/2 rounded-full bg-red-600/10 blur-[130px]"></div>
          <div class="absolute right-0 top-64 h-72 w-72 rounded-full bg-orange-500/5 blur-[100px]"></div>
          <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
        </div>

        <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-24 sm:px-8 sm:py-32 lg:grid-cols-[1.1fr_0.9fr]">

          <div>
            <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-red-500/20 bg-red-500/5 px-3 py-1.5 text-xs font-medium text-red-300">
              <span class="h-2 w-2 animate-pulse rounded-full bg-red-500"></span>
              ESTUDIO PROFESIONAL EN ROBLOX & B2B
            </div>

            <h1 class="max-w-3xl text-5xl font-black leading-[1.08] tracking-tight text-white sm:text-6xl lg:text-7xl">
              Creamos mundos.
              <span class="mt-2 block text-red-500">Impulsamos</span>
              <span class="block">tu marca.</span>
            </h1>

            <p class="mt-7 max-w-xl text-base leading-8 text-zinc-400 sm:text-lg">
              Ofrecemos <strong class="text-zinc-200">servicios corporativos de desarrollo en Roblox</strong> para empresas y reclutamos <strong class="text-zinc-200">talento con experiencia y compromiso</strong> para nuestros equipos técnicos.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href="#servicios"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-red-950/30 transition hover:-translate-y-0.5 hover:bg-red-500"
              >
                Contratar Servicios B2B
                <Icon name="lucide:arrow-right" class="h-5 w-5" />
              </a>

              <a
                href="#areas"
                class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900/50 px-6 py-3.5 font-semibold text-zinc-300 transition hover:border-zinc-700 hover:bg-zinc-900 hover:text-white"
              >
                Postularme al equipo
                <Icon name="lucide:users" class="h-5 w-5" />
              </a>
            </div>

            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-zinc-500">
              <span class="flex items-center gap-2">
                <Icon name="lucide:check-circle-2" class="h-4 w-4 text-red-400" />
                Exigimos experiencia media/avanzada
              </span>
              <span class="flex items-center gap-2">
                <Icon name="lucide:briefcase" class="h-4 w-4 text-red-400" />
                Enfoque corporativo y profesional
              </span>
            </div>
          </div>

          <!-- Panel visual informativo -->
          <div class="relative mx-auto w-full max-w-lg">
            <div class="absolute -inset-5 rounded-[2rem] bg-red-600/10 blur-3xl"></div>

            <div class="relative overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/80 shadow-2xl shadow-black/40 p-6 sm:p-8">
              <div class="flex items-center justify-between border-b border-zinc-800 pb-4 mb-6">
                <span class="font-mono text-xs text-zinc-500">studio.services & hiring</span>
                <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
              </div>

              <div class="space-y-4">
                <div class="rounded-xl border border-zinc-800 bg-zinc-950/70 p-4">
                  <p class="text-xs font-semibold uppercase text-red-400">Servicios B2B</p>
                  <p class="mt-1 text-sm font-bold text-white">Desarrollo de experiencias para marcas</p>
                </div>
                <div class="rounded-xl border border-zinc-800 bg-zinc-950/70 p-4">
                  <p class="text-xs font-semibold uppercase text-red-400">Colaboración</p>
                  <p class="mt-1 text-sm font-bold text-white">Reclutamiento activo con experiencia</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Separador -->
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="h-px bg-gradient-to-r from-transparent via-zinc-800 to-transparent"></div>
      </div>

      <!-- Servicios B2B (Para Empresas) -->
      <section id="servicios" class="scroll-mt-24 py-24">
        <div class="mx-auto max-w-6xl px-5 sm:px-8">

          <div class="mx-auto mb-14 max-w-2xl text-center">
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-red-400">
              Soluciones para Empresas
            </p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Lleva tu marca al siguiente nivel en <span class="text-red-500">Roblox</span>.
            </h2>
            <p class="mt-5 leading-7 text-zinc-400">
              Ofrecemos servicios de desarrollo a medida para corporaciones y agencias que buscan posicionarse dentro de la plataforma con altos estándares de calidad y rendimiento.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {servicesData.map((service) => (
              <article class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 transition hover:border-red-500/40 hover:-translate-y-1 flex flex-col justify-between">
                <div>
                  <div class="mb-5 flex items-center justify-between">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-500/10 text-red-400">
                      <Icon name={service.icon} class="h-6 w-6" />
                    </div>
                    <span class="rounded-full border border-zinc-800 px-2.5 py-1 text-[10px] font-medium text-zinc-400">
                      {service.badge}
                    </span>
                  </div>
                  <h3 class="text-lg font-bold text-white">{service.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-zinc-400">{service.description}</p>
                </div>
                <div class="mt-6 pt-4 border-t border-zinc-800/50">
                  <a href="#contacto" class="text-xs font-semibold text-red-400 hover:text-red-300 inline-flex items-center gap-1">
                    Solicitar información <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" />
                  </a>
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>

      <!-- Áreas de Contratación (Empleo con Experiencia) -->
      <section id="areas" class="scroll-mt-24 border-y border-zinc-900 bg-zinc-900/20 py-24">
        <div class="mx-auto max-w-6xl px-5 sm:px-8">

          <div class="mb-12 max-w-2xl">
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-red-400">
              Bolsa de Trabajo
            </p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Únete a nuestro equipo técnico.
            </h2>
            <p class="mt-5 leading-7 text-zinc-400">
              Buscamos colaboradores con <span class="text-white font-semibold">experiencia previa y compromiso real</span>. No aceptamos perfiles sin base (0 experiencia), ya que trabajamos bajo plazos y estándares profesionales.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {hiringAreas.map((area) => (
              <article class="group rounded-2xl border border-zinc-800 bg-zinc-950/70 p-6 transition hover:-translate-y-1 hover:border-red-500/40 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between">
                    <div class={`flex h-12 w-12 items-center justify-center rounded-xl ${area.iconBg} ${area.iconColor}`}>
                      <Icon name={area.icon} class="h-6 w-6" />
                    </div>
                    <span class="rounded-full border border-red-500/20 bg-red-500/5 px-2.5 py-1 text-[10px] font-medium text-red-400">
                      {area.tag}
                    </span>
                  </div>
                  <h3 class="mt-5 text-lg font-bold text-white">{area.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-zinc-400">{area.description}</p>
                </div>

                <div class="mt-6 pt-4 border-t border-zinc-800/60">
                  <p class="text-xs font-mono text-zinc-400 bg-zinc-900 p-2.5 rounded-lg border border-zinc-800/80">
                    ⚠️ {area.requirement}
                  </p>
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>

      <!-- Requisitos -->
      <section id="requisitos" class="scroll-mt-24 py-24">
        <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:items-center">

          <div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-red-400">
              Lo que exigimos
            </p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Profesionalismo y compromiso ante todo.
            </h2>
            <p class="mt-5 leading-7 text-zinc-400">
              Para garantizar el éxito de nuestros proyectos corporativos y propios, requerimos un nivel mínimo de destreza técnica y responsabilidad.
            </p>
          </div>

          <div class="space-y-4">
            {requirementsData.map((req) => (
              <div class="flex gap-4 rounded-xl border border-zinc-800 bg-zinc-900/30 p-5">
                <Icon name={req.icon} class="mt-0.5 h-5 w-5 shrink-0 text-red-400" />
                <div>
                  <h3 class="font-bold text-white">{req.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-zinc-400">{req.description}</p>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- Proceso -->
      <section id="proceso" class="scroll-mt-24 border-y border-zinc-900 bg-zinc-900/20 py-24">
        <div class="mx-auto max-w-6xl px-5 sm:px-8">

          <div class="mx-auto mb-14 max-w-2xl text-center">
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-red-400">
              Cómo trabajamos
            </p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Tres pasos para empezar.
            </h2>
            <p class="mt-5 leading-7 text-zinc-400">
              Ya sea que busques contratar nuestros servicios o postularte como colaborador, el flujo es directo y transparente.
            </p>
          </div>

          <div class="grid gap-5 md:grid-cols-3">
            {processSteps.map((p) => (
              <article class="rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6">
                <span class="font-mono text-sm font-bold text-red-400">{p.step} / PASO</span>
                <h3 class="mt-5 text-lg font-bold text-white">{p.title}</h3>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{p.description}</p>
              </article>
            ))}
          </div>

        </div>
      </section>
<!-- CTA / Contacto (Dividido en Servicios y Empleo) -->
      <section id="contacto" class="scroll-mt-24 py-24">
        <div class="mx-auto max-w-6xl px-5 sm:px-8">
          
          <div class="mx-auto mb-12 max-w-2xl text-center">
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-red-400">
              ¿Cómo podemos ayudarte?
            </p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Da el siguiente paso con nosotros.
            </h2>
            <p class="mt-4 text-sm text-zinc-400">
              Selecciona la opción que mejor se adapte a lo que estás buscando.
            </p>
          </div>

          <div class="grid gap-8 md:grid-cols-2">

            <!-- Opción 1: Empresas / Contratar Servicios -->
            <div class="relative isolate overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/90 p-8 sm:p-10 flex flex-col justify-between transition hover:border-red-500/30">
              <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(220,38,38,0.12),transparent_70%)]"></div>

              <div>
                <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-red-500/20 bg-red-500/10 text-red-400">
                  <Icon name="lucide:building-2" class="h-7 w-7" />
                </div>

                <span class="text-xs font-bold uppercase tracking-wider text-red-400">Para Empresas y Agencias</span>
                <h3 class="mt-2 text-2xl font-bold text-white">Contratar Servicios B2B</h3>
                <p class="mt-4 text-sm leading-7 text-zinc-400">
                  ¿Buscas crear una experiencia personalizada en Roblox para tu marca o proyecto? Desarrollamos juegos, mapas y sistemas con estándares corporativos y entregas a tiempo.
                </p>
              </div>

              <div class="mt-8 pt-6 border-t border-zinc-800/80">
                <a
                  href="/servicios-contact"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-red-600 px-6 py-3.5 font-bold text-white shadow-lg shadow-red-950/30 transition hover:bg-red-500"
                >
                  <Icon name="lucide:briefcase" class="h-5 w-5" />
                  Solicitar Cotización
                  <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
                </a>
              </div>
            </div>

            <!-- Opción 2: Desarrolladores / Solicitar Trabajo -->
            <div class="relative isolate overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/90 p-8 sm:p-10 flex flex-col justify-between transition hover:border-red-500/30">
              <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(239,68,68,0.08),transparent_70%)]"></div>

              <div>
                <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-zinc-700 bg-zinc-800/60 text-zinc-300">
                  <Icon name="lucide:user-check" class="h-7 w-7" />
                </div>

                <span class="text-xs font-bold uppercase tracking-wider text-zinc-400">Para Desarrolladores (Experiencia requerida)</span>
                <h3 class="mt-2 text-2xl font-bold text-white">Unirse al Equipo Técnico</h3>
                <p class="mt-4 text-sm leading-7 text-zinc-400">
                  ¿Tienes experiencia demostrable en Luau, modelado 3D, UI/UX o construcción en Roblox Studio? Presenta tu portafolio y participa en proyectos de alto impacto.
                </p>
              </div>

              <div class="mt-8 pt-6 border-t border-zinc-800/80">
                <a
                  href="/quest"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-zinc-700 bg-zinc-950/60 px-6 py-3.5 font-bold text-zinc-200 transition hover:border-zinc-600 hover:bg-zinc-900 hover:text-white"
                >
                  <Icon name="lucide:file-text" class="h-5 w-5" />
                  Enviar Portafolio
                  <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
                </a>
              </div>
            </div>

          </div>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-900 bg-zinc-950 py-8">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 text-center sm:px-8 md:flex-row md:text-left">
        <span class="text-sm font-bold text-zinc-300">{siteConfig.name}</span>
        <p class="text-xs text-zinc-500">© {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.</p>
      </div>
    </footer>

  </body>
</html>

