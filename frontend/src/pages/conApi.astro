---
import "../style/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <title>Recruitment | Beware of the Rat</title>
    <meta
      name="description"
      content="Panel de gestión de solicitudes de trabajo de Beware of the Rat."
    />
  </head>

  <body>
    <div class="recruitment-page">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Beware of the Rat">
          <span class="brand-icon">R</span>
          <span>
            <strong>BEWARE OF THE RAT</strong>
            <small>DEVELOPMENT TEAM</small>
          </span>
        </a>

        <span class="footer-code">BTR // RECRUITMENT</span>
      </header>

      <main class="recruitment-main">
        <section class="page-heading">
          <div>
            <span class="eyebrow">
              <span class="status-dot"></span>
              RECRUITMENT DEPARTMENT
            </span>

            <h1>Solicitudes de trabajo<span class="accent">.</span></h1>

            <p>
              Revisa las solicitudes recibidas y decide quién puede formar
              parte del equipo.
            </p>
          </div>

          <button id="refreshButton" class="button button-secondary" type="button">
            <span aria-hidden="true">↻</span>
            Actualizar
          </button>
        </section>

        <section class="stats-grid" aria-label="Resumen de solicitudes">
          <article class="stat-card">
            <span class="stat-label">TOTAL SOLICITUDES</span>
            <div class="stat-bottom">
              <strong id="totalCount">—</strong>
              <span class="stat-symbol">#</span>
            </div>
            <span class="stat-description">Registros recibidos</span>
          </article>

          <article class="stat-card">
            <span class="stat-label">PENDIENTES</span>
            <div class="stat-bottom">
              <strong id="pendingCount">—</strong>
              <span class="stat-symbol pending-symbol">◷</span>
            </div>
            <span class="stat-description">Esperando revisión</span>
          </article>

          <article class="stat-card">
            <span class="stat-label">ACEPTADAS</span>
            <div class="stat-bottom">
              <strong id="acceptedCount">—</strong>
              <span class="stat-symbol accepted-symbol">✓</span>
            </div>
            <span class="stat-description">Solicitudes aprobadas</span>
          </article>
        </section>

        <div class="workspace">
          <section class="panel form-panel">
            <div class="panel-heading">
              <div>
                <span class="section-index">01 / REGISTRO</span>
                <h2>Nueva solicitud</h2>
                <p>Introduce los datos de la persona.</p>
              </div>
              <span class="heading-symbol" aria-hidden="true">+</span>
            </div>

            <form id="applicationForm">
              <div class="field">
                <label for="nombre">Nombre completo <span>*</span></label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  maxlength="100"
                  placeholder="Nombre y apellidos"
                  autocomplete="name"
                  required
                />
              </div>

              <div class="field">
                <label for="correo">Correo electrónico <span>*</span></label>
                <input
                  id="correo"
                  name="correo"
                  type="email"
                  maxlength="150"
                  placeholder="persona@correo.com"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="field">
                <label for="telefono">Teléfono</label>
                <input
                  id="telefono"
                  name="telefono"
                  type="tel"
                  maxlength="20"
                  placeholder="+57 300 000 0000"
                  autocomplete="tel"
                />
              </div>

              <div class="field">
                <label for="experiencia">Experiencia y habilidades</label>
                <textarea
                  id="experiencia"
                  name="experiencia"
                  rows="5"
                  placeholder="Conocimientos, experiencia y habilidades..."
                ></textarea>
              </div>

              <div id="formMessage" class="message" role="status" aria-live="polite" hidden></div>

              <button id="submitButton" class="button button-primary button-full" type="submit">
                <span aria-hidden="true">+</span>
                Registrar solicitud
              </button>

              <p class="form-note">
                Los campos marcados con * son obligatorios.
              </p>
            </form>
          </section>

          <section class="panel applications-panel">
            <div class="panel-heading applications-heading">
              <div>
                <span class="section-index">02 / SOLICITUDES</span>
                <h2>Personas interesadas</h2>
                <p>Consulta la información y gestiona cada registro.</p>
              </div>
            </div>

            <div class="list-toolbar">
              <label for="statusFilter">FILTRAR POR ESTADO</label>

              <select id="statusFilter">
                <option value="">Todos los estados</option>
                <option value="pendiente">Pendientes</option>
                <option value="aceptada">Aceptadas</option>
                <option value="rechazada">Rechazadas</option>
              </select>
            </div>

            <div id="listMessage" class="message list-message" role="status" aria-live="polite" hidden></div>

            <div id="applicationsList" class="applications-list">
              <div class="empty-state">
                <span class="loading-symbol">↻</span>
                <p>Cargando solicitudes...</p>
              </div>
            </div>

            <div class="list-footer">
              <span id="resultsCount">Cargando registros...</span>
              <span> BTR / DATABASE </span>
            </div>
          </section>
        </div>
      </main>

      <footer>
        <a class="brand footer-brand" href="/">
          <span class="brand-icon">R</span>
          <span>
            <strong>BEWARE OF THE RAT</strong>
            <small>BUILD SOMETHING DIFFERENT.</small>
          </span>
        </a>

        <p>Hecho para quienes quieren crear algo juntos.</p>

        <span class="footer-code">BTR // RECRUITMENT</span>
      </footer>
    </div>

    <script>
      const API_URL = "https://dev1.nanadev.online";

      type Estado = "pendiente" | "aceptada" | "rechazada";

      interface Solicitud {
        id: number;
        nombre: string;
        correo: string;
        telefono: string | null;
        experiencia: string | null;
        estado: Estado;
        fecha_solicitud: string;
      }

      const form = document.querySelector<HTMLFormElement>("#applicationForm")!;
      const submitButton = document.querySelector<HTMLButtonElement>("#submitButton")!;
      const formMessage = document.querySelector<HTMLDivElement>("#formMessage")!;
      const listMessage = document.querySelector<HTMLDivElement>("#listMessage")!;
      const applicationsList = document.querySelector<HTMLDivElement>("#applicationsList")!;
      const statusFilter = document.querySelector<HTMLSelectElement>("#statusFilter")!;
      const refreshButton = document.querySelector<HTMLButtonElement>("#refreshButton")!;
      const resultsCount = document.querySelector<HTMLSpanElement>("#resultsCount")!;

      let solicitudes: Solicitud[] = [];
      let enviando = false;
      let actualizandoEstado = false;
      let cargando = false;

      function escapar(valor: unknown): string {
        return String(valor ?? "").replace(/[&<>"']/g, (caracter) => {
          const entidades: Record<string, string> = {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          };
          return entidades[caracter];
        });
      }

      function mostrarMensaje(
        elemento: HTMLElement,
        mensaje: string,
        tipo: "error" | "success"
      ) {
        elemento.textContent = mensaje;
        elemento.className = `message ${tipo === "error" ? "message-error" : "message-success"}`;
        elemento.hidden = false;
      }

      function ocultarMensaje(elemento: HTMLElement) {
        elemento.hidden = true;
        elemento.textContent = "";
      }

      async function peticion<T>(
        ruta: string,
        opciones: RequestInit = {}
      ): Promise<T> {
        let respuesta: Response;

        try {
          respuesta = await fetch(`${API_URL}${ruta}`, {
            ...opciones,
            headers: {
              "Content-Type": "application/json",
              ...opciones.headers,
            },
          });
        } catch {
          throw new Error(
            "No se pudo conectar con la API. Comprueba su URL y la configuración CORS."
          );
        }

        if (!respuesta.ok) {
          let mensaje = `Error del servidor (${respuesta.status}).`;

          try {
            const cuerpo = await respuesta.json();
            if (typeof cuerpo.detail === "string") {
              mensaje = cuerpo.detail;
            }
          } catch {
            // La respuesta no contiene JSON.
          }

          throw new Error(mensaje);
        }

        return respuesta.json() as Promise<T>;
      }

      function fechaLegible(fecha: string): string {
        const valor = new Date(fecha);

        if (Number.isNaN(valor.getTime())) {
          return "Fecha no disponible";
        }

        return valor.toLocaleString("es-CO", {
          dateStyle: "medium",
          timeStyle: "short",
        });
      }

      function etiquetaEstado(estado: Estado): string {
        const configuracion: Record<Estado, { nombre: string; simbolo: string }> = {
          pendiente: { nombre: "Pendiente", simbolo: "◷" },
          aceptada: { nombre: "Aceptada", simbolo: "✓" },
          rechazada: { nombre: "Rechazada", simbolo: "×" },
        };

        const dato = configuracion[estado];

        return `
          <span class="status-badge status-${estado}">
            <span aria-hidden="true">${dato.simbolo}</span>
            ${dato.nombre}
          </span>`;
      }

      function actualizarEstadisticas() {
        document.querySelector("#totalCount")!.textContent = String(solicitudes.length);

        document.querySelector("#pendingCount")!.textContent = String(
          solicitudes.filter((s) => s.estado === "pendiente").length
        );

        document.querySelector("#acceptedCount")!.textContent = String(
          solicitudes.filter((s) => s.estado === "aceptada").length
        );
      }

      function renderizarSolicitudes() {
        const filtro = statusFilter.value as Estado | "";
        const filtradas = filtro
          ? solicitudes.filter((s) => s.estado === filtro)
          : solicitudes;

        actualizarEstadisticas();

        resultsCount.textContent =
          `${filtradas.length} ${filtradas.length === 1 ? "solicitud encontrada" : "solicitudes encontradas"}`;

        if (filtradas.length === 0) {
          applicationsList.innerHTML = `
            <div class="empty-state">
              <span class="empty-symbol">—</span>
              <h3>No hay solicitudes</h3>
              <p>No se encontraron registros para este filtro.</p>
            </div>`;
          return;
        }

        applicationsList.innerHTML = filtradas.map((s) => {
          const acciones = s.estado === "pendiente"
            ? `
              <div class="application-actions">
                <button
                  type="button"
                  data-id="${s.id}"
                  data-estado="aceptada"
                  class="button button-accept"
                >
                  <span aria-hidden="true">✓</span>
                  Aceptar solicitud
                </button>

                <button
                  type="button"
                  data-id="${s.id}"
                  data-estado="rechazada"
                  class="button button-reject"
                >
                  <span aria-hidden="true">×</span>
                  Rechazar
                </button>
              </div>`
            : "";

          const inicial = escapar(s.nombre.trim().charAt(0).toUpperCase() || "?");

          return `
            <article class="application-card">
              <div class="application-top">
                <div class="applicant">
                  <div class="applicant-avatar">${inicial}</div>

                  <div class="applicant-identity">
                    <h3>${escapar(s.nombre)}</h3>
                    <a href="mailto:${escapar(s.correo)}">${escapar(s.correo)}</a>
                    <span class="application-id">APPLICATION #${s.id}</span>
                  </div>
                </div>

                ${etiquetaEstado(s.estado)}
              </div>

              <div class="application-details">
                <div class="detail-item">
                  <span class="detail-label">TELÉFONO</span>
                  <span class="detail-value">${escapar(s.telefono || "No proporcionado")}</span>
                </div>

                <div class="detail-item">
                  <span class="detail-label">FECHA DE REGISTRO</span>
                  <span class="detail-value">${escapar(fechaLegible(s.fecha_solicitud))}</span>
                </div>

                <div class="detail-item detail-experience">
                  <span class="detail-label">EXPERIENCIA Y HABILIDADES</span>
                  <p>${escapar(s.experiencia || "Sin información adicional.")}</p>
                </div>
              </div>

              ${acciones}
            </article>`;
        }).join("");
      }

      async function cargarSolicitudes() {
        if (cargando) return;

        cargando = true;
        refreshButton.disabled = true;
        ocultarMensaje(listMessage);

        try {
          const resultado = await peticion<Solicitud[]>("/solicitudes");
          solicitudes = resultado;
          renderizarSolicitudes();
        } catch (error) {
          applicationsList.innerHTML = `
            <div class="empty-state error-state">
              <span class="empty-symbol">!</span>
              <h3>No se pudieron cargar las solicitudes</h3>
              <p>${escapar(error instanceof Error ? error.message : "Error desconocido")}</p>
            </div>`;

          resultsCount.textContent = "Error al cargar los registros";

          document.querySelector("#totalCount")!.textContent = "—";
          document.querySelector("#pendingCount")!.textContent = "—";
          document.querySelector("#acceptedCount")!.textContent = "—";
        } finally {
          cargando = false;
          refreshButton.disabled = false;
        }
      }

      form.addEventListener("submit", async (evento) => {
        evento.preventDefault();

        if (enviando) return;

        enviando = true;
        submitButton.disabled = true;
        ocultarMensaje(formMessage);

        const datos = new FormData(form);

        const nuevaSolicitud = {
          nombre: String(datos.get("nombre") ?? "").trim(),
          correo: String(datos.get("correo") ?? "").trim(),
          telefono: String(datos.get("telefono") ?? "").trim() || null,
          experiencia: String(datos.get("experiencia") ?? "").trim() || null,
        };

        try {
          await peticion("/solicitudes", {
            method: "POST",
            body: JSON.stringify(nuevaSolicitud),
          });

          form.reset();
          mostrarMensaje(formMessage, "Solicitud registrada correctamente.", "success");

          await cargarSolicitudes();
        } catch (error) {
          mostrarMensaje(
            formMessage,
            error instanceof Error ? error.message : "No fue posible registrar la solicitud.",
            "error"
          );
        } finally {
          enviando = false;
          submitButton.disabled = false;
        }
      });

      applicationsList.addEventListener("click", async (evento) => {
        const objetivo = evento.target;

        if (!(objetivo instanceof Element)) return;

        const boton = objetivo.closest<HTMLButtonElement>("button[data-id][data-estado]");

        if (!boton || actualizandoEstado || cargando) return;

        const id = Number(boton.dataset.id);
        const estado = boton.dataset.estado as Estado;

        if (
          !Number.isInteger(id) ||
          id < 1 ||
          (estado !== "aceptada" && estado !== "rechazada")
        ) {
          return;
        }

        const solicitud = solicitudes.find((s) => s.id === id);

        if (!solicitud || solicitud.estado !== "pendiente") return;

        const accion = estado === "aceptada" ? "aceptar" : "rechazar";

        if (!window.confirm(`¿Deseas ${accion} la solicitud de ${solicitud.nombre}?`)) {
          return;
        }

        actualizandoEstado = true;

        applicationsList
          .querySelectorAll<HTMLButtonElement>("button[data-id]")
          .forEach((b) => { b.disabled = true; });

        ocultarMensaje(listMessage);

        try {
          await peticion(`/solicitudes/${id}/estado`, {
            method: "PATCH",
            body: JSON.stringify({ estado }),
          });

          await cargarSolicitudes();

          mostrarMensaje(
            listMessage,
            `La solicitud #${id} fue ${estado === "aceptada" ? "aceptada" : "rechazada"} correctamente.`,
            "success"
          );
        } catch (error) {
          mostrarMensaje(
            listMessage,
            error instanceof Error ? error.message : "No fue posible actualizar el estado.",
            "error"
          );
        } finally {
          actualizandoEstado = false;

          applicationsList
            .querySelectorAll<HTMLButtonElement>("button[data-id]")
            .forEach((b) => { b.disabled = false; });
        }
      });

      statusFilter.addEventListener("change", renderizarSolicitudes);
      refreshButton.addEventListener("click", cargarSolicitudes);

      cargarSolicitudes();
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #09090b;
        color: #e4e4e7;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      :global(button),
      :global(input),
      :global(textarea),
      :global(select) {
        font: inherit;
      }

      .recruitment-page {
        --surface: #111113;
        --surface-raised: #171719;
        --border: #29292e;
        --muted: #92929d;
        --accent: #c4a1ff;
        --green: #86d6aa;
        --red: #f29a9a;
        min-height: 100vh;
        width: min(100% - 48px, 1440px);
        margin-inline: auto;
      }

      .topbar {
        min-height: 94px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--border);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 13px;
        color: inherit;
        text-decoration: none;
      }

      .brand-icon {
        display: grid;
        width: 43px;
        height: 43px;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid #55515d;
        background: #1b1920;
        color: #e1d3ff;
        font-size: 21px;
        font-weight: 800;
      }

      .brand strong,
      .brand small {
        display: block;
      }

      .brand strong {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
      }

      .brand small {
        margin-top: 5px;
        color: var(--muted);
        font-size: 9px;
        letter-spacing: 1.8px;
      }

      .footer-code {
        color: #85818d;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
        letter-spacing: 1.5px;
      }

      .recruitment-main {
        padding-block: 58px 72px;
      }

      .page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 36px;
      }

      .eyebrow,
      .section-index,
      .stat-label,
      .detail-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.5px;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--accent);
      }

      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #bda0ff;
        box-shadow: 0 0 12px #bda0ff55;
      }

      .page-heading h1 {
        margin: 18px 0 12px;
        color: #f4f4f5;
        font-size: clamp(29px, 4vw, 43px);
        font-weight: 750;
        letter-spacing: -1.8px;
        line-height: 1.12;
      }

      .accent {
        color: var(--accent);
      }

      .page-heading p,
      .panel-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 40px;
        padding: 10px 14px;
        border: 1px solid transparent;
        border-radius: 4px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 650;
        transition: background .18s ease, border-color .18s ease, color .18s ease;
      }

      .button:disabled {
        cursor: not-allowed;
        opacity: .55;
      }

      .button-secondary {
        flex-shrink: 0;
        border-color: var(--border);
        background: #141416;
        color: #dedee4;
      }

      .button-secondary:hover {
        border-color: #55515d;
        background: #1d1d20;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 34px;
      }

      .stat-card,
      .panel {
        border: 1px solid var(--border);
        background: var(--surface);
      }

      .stat-card {
        min-width: 0;
        padding: 22px;
      }

      .stat-label {
        color: var(--muted);
      }

      .stat-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 23px;
      }

      .stat-bottom strong {
        font-size: 34px;
        font-weight: 650;
        letter-spacing: -1px;
      }

      .stat-symbol {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border: 1px solid #38313f;
        background: #211b2a;
        color: var(--accent);
        font-size: 17px;
      }

      .pending-symbol {
        border-color: #55432c;
        background: #282016;
        color: #e8bd79;
      }

      .accepted-symbol {
        border-color: #284635;
        background: #17251d;
        color: var(--green);
      }

      .stat-description {
        display: block;
        margin-top: 8px;
        color: var(--muted);
        font-size: 11px;
      }

      .workspace {
        display: grid;
        grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
        align-items: start;
        gap: 20px;
      }

      .panel {
        min-width: 0;
      }

      .form-panel {
        padding: 24px;
      }

      .panel-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 26px;
      }

      .section-index {
        color: var(--accent);
      }

      .panel-heading h2 {
        margin: 13px 0 7px;
        color: #f4f4f5;
        font-size: 18px;
        font-weight: 650;
        letter-spacing: -.4px;
      }

      .panel-heading p {
        font-size: 12px;
      }

      .heading-symbol {
        display: grid;
        width: 37px;
        height: 37px;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid #40334f;
        background: #211b2a;
        color: var(--accent);
        font-size: 23px;
      }

      .field {
        margin-bottom: 20px;
      }

      .field label {
        display: block;
        margin-bottom: 9px;
        color: #d4d4d8;
        font-size: 12px;
        font-weight: 550;
      }

      .field label span {
        color: var(--accent);
      }

      .field input,
      .field textarea,
      .list-toolbar select {
        display: block;
        width: 100%;
        min-width: 0;
        border: 1px solid #303035;
        border-radius: 3px;
        outline: none;
        background: #0d0d0f;
        color: #ededf0;
        font-size: 12px;
        transition: border-color .18s ease, box-shadow .18s ease;
      }

      .field input,
      .field textarea {
        padding: 12px;
      }

      .field textarea {
        min-height: 110px;
        resize: vertical;
        line-height: 1.7;
      }

      .field input::placeholder,
      .field textarea::placeholder {
        color: #686873;
      }

      .field input:focus,
      .field textarea:focus,
      .list-toolbar select:focus {
        border-color: #8b6ac0;
        box-shadow: 0 0 0 3px #a78bfa12;
      }

      .button-primary {
        border-color: #b69ae7;
        background: #c4a1ff;
        color: #19121f;
      }

      .button-primary:hover {
        background: #d3baff;
      }

      .button-full {
        width: 100%;
        min-height: 44px;
      }

      .form-note {
        margin: 14px 0 0;
        color: #777782;
        font-size: 10px;
        line-height: 1.6;
      }

      .message {
        margin-bottom: 16px;
        padding: 12px;
        border: 1px solid;
        border-radius: 3px;
        font-size: 12px;
        line-height: 1.7;
        overflow-wrap: anywhere;
      }

      .message[hidden] {
        display: none;
      }

      .message-error {
        border-color: #6c3030;
        background: #271416;
        color: #ffb4b4;
      }

      .message-success {
        border-color: #28543a;
        background: #13251a;
        color: #a5e5bb;
      }

      .applications-panel {
        overflow: hidden;
      }

      .applications-heading {
        margin: 0;
        padding: 24px;
      }

      .list-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 15px 24px;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: #0e0e10;
      }

      .list-toolbar label {
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        letter-spacing: 1px;
      }

      .list-toolbar select {
        width: auto;
        max-width: 58%;
        padding: 9px 10px;
      }

      .list-message {
        margin: 16px 20px 0;
      }

      .applications-list {
        min-height: 200px;
      }

      .application-card {
        padding: 23px 24px;
        border-bottom: 1px solid #29292e;
        transition: background .18s ease;
      }

      .application-card:last-child {
        border-bottom: 0;
      }

      .application-card:hover {
        background: #ffffff03;
      }

      .application-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
      }

      .applicant {
        display: flex;
        min-width: 0;
        align-items: flex-start;
        gap: 13px;
      }

      .applicant-avatar {
        display: grid;
        width: 42px;
        height: 42px;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid #453751;
        background: #211b2a;
        color: #d9c5ff;
        font-size: 15px;
        font-weight: 700;
      }

      .applicant-identity {
        display: flex;
        min-width: 0;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
      }

      .applicant-identity h3 {
        margin: 0;
        color: #f4f4f5;
        font-size: 14px;
        font-weight: 650;
        overflow-wrap: anywhere;
      }

      .applicant-identity a {
        color: #aaa0bd;
        font-size: 12px;
        overflow-wrap: anywhere;
        text-decoration: none;
      }

      .applicant-identity a:hover {
        color: #d7c3ff;
        text-decoration: underline;
      }

      .application-id {
        margin-top: 3px;
        color: #777782;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        letter-spacing: 1px;
      }

      .status-badge {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border: 1px solid;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 600;
      }

      .status-pendiente {
        border-color: #5a452b;
        background: #241c12;
        color: #e8bd79;
      }

      .status-aceptada {
        border-color: #28543a;
        background: #14251a;
        color: var(--green);
      }

      .status-rechazada {
        border-color: #603235;
        background: #291719;
        color: var(--red);
      }

      .application-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-top: 22px;
        padding: 17px;
        border: 1px solid #29292e;
        background: #0d0d0f;
      }

      .detail-item {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 8px;
      }

      .detail-label {
        color: #858590;
        font-size: 9px;
        letter-spacing: 1px;
      }

      .detail-value {
        color: #d4d4d8;
        font-size: 12px;
        overflow-wrap: anywhere;
      }

      .detail-experience {
        grid-column: 1 / -1;
        padding-top: 14px;
        border-top: 1px solid #29292e;
      }

      .detail-experience p {
        margin: 0;
        color: #b8b8c2;
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
      }

      .application-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 17px;
      }

      .button-accept {
        border-color: #28543a;
        background: #14251a;
        color: var(--green);
      }

      .button-accept:hover {
        background: #1b3625;
      }

      .button-reject {
        border-color: #603235;
        background: #291719;
        color: var(--red);
      }

      .button-reject:hover {
        background: #3a2022;
      }

      .empty-state {
        display: flex;
        min-height: 230px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 24px;
        text-align: center;
      }

      .empty-symbol,
      .loading-symbol {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        margin-bottom: 15px;
        border: 1px solid #37333f;
        color: var(--accent);
        font-size: 21px;
      }

      .empty-state h3 {
        margin: 0;
        color: #e4e4e7;
        font-size: 14px;
      }

      .empty-state p {
        max-width: 360px;
        margin: 10px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
      }

      .error-state .empty-symbol {
        border-color: #603235;
        color: var(--red);
      }

      .loading-symbol {
        animation: spin 1.2s linear infinite;
      }

      .list-footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 15px 24px;
        border-top: 1px solid var(--border);
        color: #858590;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        letter-spacing: .6px;
      }

      footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 27px 0;
        border-top: 1px solid var(--border);
      }

      .footer-brand .brand-icon {
        width: 36px;
        height: 36px;
        font-size: 17px;
      }

      .footer-brand strong {
        font-size: 10px;
      }

      .footer-brand small {
        font-size: 8px;
      }

      footer > p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      @media (max-width: 950px) {
        .workspace {
          grid-template-columns: minmax(0, 1fr);
        }

        .form-panel {
          max-width: none;
        }
      }

      @media (max-width: 600px) {
        .recruitment-page {
          width: calc(100% - 30px);
        }

        .topbar {
          min-height: 78px;
        }

        .brand {
          gap: 9px;
        }

        .brand-icon {
          width: 37px;
          height: 37px;
        }

        .brand strong {
          font-size: 10px;
          letter-spacing: .8px;
        }

        .brand small {
          font-size: 8px;
          letter-spacing: 1px;
        }

        .topbar > .footer-code {
          font-size: 8px;
          letter-spacing: .4px;
          text-align: right;
        }

        .recruitment-main {
          padding-block: 38px 45px;
        }

        .page-heading {
          align-items: flex-start;
          flex-direction: column;
          margin-bottom: 26px;
        }

        .page-heading h1 {
          font-size: 32px;
          letter-spacing: -1.2px;
        }

        .page-heading > .button {
          width: 100%;
        }

        .stats-grid {
          gap: 8px;
          margin-bottom: 22px;
        }

        .stat-card {
          padding: 12px 10px;
        }

        .stat-label {
          font-size: 8px;
          letter-spacing: .3px;
        }

        .stat-bottom {
          margin-top: 16px;
        }

        .stat-bottom strong {
          font-size: 25px;
        }

        .stat-symbol {
          width: 25px;
          height: 25px;
          font-size: 13px;
        }

        .stat-description {
          font-size: 9px;
          line-height: 1.5;
        }

        .form-panel {
          padding: 18px;
        }

        .applications-heading {
          padding: 20px 18px;
        }

        .list-toolbar {
          align-items: flex-start;
          flex-direction: column;
          padding: 14px 18px;
        }

        .list-toolbar select {
          width: 100%;
          max-width: none;
        }

        .application-card {
          padding: 18px;
        }

        .application-top {
          flex-direction: column;
        }

        .application-details {
          grid-template-columns: minmax(0, 1fr);
          gap: 17px;
          padding: 14px;
        }

        .detail-experience {
          grid-column: auto;
        }

        .application-actions {
          flex-direction: column;
        }

        .application-actions .button {
          width: 100%;
        }

        .list-footer {
          padding-inline: 15px;
          font-size: 8px;
        }

        footer {
          align-items: flex-start;
          flex-direction: column;
          gap: 18px;
        }

        footer > p {
          line-height: 1.7;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .loading-symbol {
          animation: none;
        }

        .button,
        .application-card {
          transition: none;
        }
      }
    </style>
  </body>
</html>
