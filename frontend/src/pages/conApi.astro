
---
import "../style/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0a0f" />
    <meta
      name="description"
      content="Panel de gestión de solicitudes de trabajo de Beware of the Rat."
    />
    <title>Solicitudes | Beware of the Rat</title>
  </head>

  <body>
    <div class="app">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Beware of the Rat, inicio">
          <span class="brand-mark">R</span>
          <span class="brand-copy">
            <strong>DREAM PROJECTS STUDIO</strong>
            <small>DEVELOPMENT TEAM</small>
          </span>
        </a>

        <span class="topbar-label">
          <span class="online-dot"></span>
          PANEL DE RECLUTAMIENTO
        </span>
      </header>

      <main>
        <section class="hero">
          <div class="hero-copy">
            <span class="eyebrow">GESTIÓN DE TALENTO</span>
            <h1>Solicitudes<span class="accent">.</span></h1>
            <p>
              Revisa a las personas interesadas en formar parte del equipo
              y gestiona sus solicitudes desde un solo lugar.
            </p>
          </div>

          <button id="refreshButton" class="button button-secondary" type="button">
            <span aria-hidden="true">↻</span>
            Actualizar
          </button>
        </section>

        <section class="stats-grid" aria-label="Resumen de solicitudes">
          <article class="stat-card">
            <div class="stat-card-top">
              <span class="stat-label">TOTAL RECIBIDAS</span>
              <span class="stat-icon icon-purple" aria-hidden="true">#</span>
            </div>
            <strong class="stat-number" id="totalCount">—</strong>
            <span class="stat-description">Solicitudes registradas</span>
          </article>

          <article class="stat-card">
            <div class="stat-card-top">
              <span class="stat-label">PENDIENTES</span>
              <span class="stat-icon icon-yellow" aria-hidden="true">◷</span>
            </div>
            <strong class="stat-number" id="pendingCount">—</strong>
            <span class="stat-description">Esperando revisión</span>
          </article>

          <article class="stat-card">
            <div class="stat-card-top">
              <span class="stat-label">ACEPTADAS</span>
              <span class="stat-icon icon-green" aria-hidden="true">✓</span>
            </div>
            <strong class="stat-number" id="acceptedCount">—</strong>
            <span class="stat-description">Solicitudes aprobadas</span>
          </article>
        </section>

        <div class="workspace">
          <section class="panel form-panel">
            <div class="panel-heading">
              <div>
                <span class="section-index">01 — REGISTRO</span>
                <h2>Nueva solicitud</h2>
                <p>Registra los datos de una persona interesada.</p>
              </div>
              <span class="heading-icon" aria-hidden="true">+</span>
            </div>

            <form id="applicationForm">
              <div class="field">
                <label for="nombre">
                  Nombre completo <span class="required">*</span>
                </label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  maxlength="100"
                  placeholder="Ej. Juan Pérez"
                  autocomplete="name"
                  required
                />
              </div>

              <div class="field">
                <label for="correo">
                  Correo electrónico <span class="required">*</span>
                </label>
                <input
                  id="correo"
                  name="correo"
                  type="email"
                  maxlength="150"
                  placeholder="persona@correo.com"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="field">
                <label for="telefono">Teléfono</label>
                <input
                  id="telefono"
                  name="telefono"
                  type="tel"
                  maxlength="20"
                  placeholder="+57 300 000 0000"
                  autocomplete="tel"
                />
              </div>

              <div class="field">
                <label for="experiencia">Experiencia y habilidades</label>
                <textarea
                  id="experiencia"
                  name="experiencia"
                  rows="5"
                  maxlength="5000"
                  placeholder="Conocimientos, tecnologías, experiencia y habilidades..."
                ></textarea>
                <span class="field-hint">
                  Describe brevemente los conocimientos de la persona.
                </span>
              </div>

              <div
                id="formMessage"
                class="message"
                role="status"
                aria-live="polite"
                hidden
              ></div>

              <button
                id="submitButton"
                class="button button-primary button-full"
                type="submit"
              >
                <span aria-hidden="true">+</span>
                Registrar solicitud
              </button>

              <p class="form-note">
                <span class="required">*</span> Campos obligatorios.
              </p>
            </form>
          </section>

          <section class="panel applications-panel">
            <div class="panel-heading applications-heading">
              <div>
                <span class="section-index">02 — REGISTROS</span>
                <h2>Personas interesadas</h2>
                <p>Consulta y gestiona las solicitudes recibidas.</p>
              </div>

              <span class="results-counter">
                <span class="online-dot"></span>
                <span id="resultsCount">Cargando...</span>
              </span>
            </div>

            <div class="list-toolbar">
              <div class="filter-copy">
                <label for="statusFilter">Filtrar solicitudes</label>
                <span>Selecciona un estado para encontrar registros.</span>
              </div>

              <select id="statusFilter">
                <option value="">Todos los estados</option>
                <option value="pendiente">Pendientes</option>
                <option value="aceptada">Aceptadas</option>
                <option value="rechazada">Rechazadas</option>
              </select>
            </div>

            <div
              id="listMessage"
              class="message list-message"
              role="status"
              aria-live="polite"
              hidden
            ></div>

            <div id="applicationsList" class="applications-list">
              <div class="empty-state">
                <span class="loading-spinner" aria-hidden="true"></span>
                <h3>Cargando solicitudes</h3>
                <p>Estamos consultando los registros disponibles.</p>
              </div>
            </div>

            <div class="list-footer">
              <span>BEWARE OF THE RAT</span>
              <span id="lastUpdated">ESPERANDO DATOS</span>
            </div>
          </section>
        </div>
      </main>

      <footer class="footer">
        <a class="brand footer-brand" href="/">
          <span class="brand-mark">R</span>
          <span class="brand-copy">
            <strong>BEWARE OF THE RAT</strong>
            <small>BUILD SOMETHING DIFFERENT.</small>
          </span>
        </a>

        <p>Construyendo el equipo, una solicitud a la vez.</p>
      </footer>
    </div>

    <script>
      const API_URL = "https://dreamprojectsstudioapi.nanadev.online";

      type Estado = "pendiente" | "aceptada" | "rechazada";

      interface Solicitud {
        id: number;
        nombre: string;
        correo: string;
        telefono: string | null;
        experiencia: string | null;
        estado: Estado;
        fecha_solicitud: string;
      }

      const obtener = <T extends HTMLElement>(selector: string): T => {
        const elemento = document.querySelector<T>(selector);

        if (!elemento) {
          throw new Error(`No se encontró el elemento ${selector}`);
        }

        return elemento;
      };

      const form = obtener<HTMLFormElement>("#applicationForm");
      const submitButton = obtener<HTMLButtonElement>("#submitButton");
      const formMessage = obtener<HTMLDivElement>("#formMessage");
      const listMessage = obtener<HTMLDivElement>("#listMessage");
      const applicationsList = obtener<HTMLDivElement>("#applicationsList");
      const statusFilter = obtener<HTMLSelectElement>("#statusFilter");
      const refreshButton = obtener<HTMLButtonElement>("#refreshButton");
      const resultsCount = obtener<HTMLSpanElement>("#resultsCount");
      const lastUpdated = obtener<HTMLSpanElement>("#lastUpdated");

      let solicitudes: Solicitud[] = [];
      let enviando = false;
      let actualizandoEstado = false;
      let cargando = false;

      function escapar(valor: unknown): string {
        return String(valor ?? "").replace(/[&<>"']/g, (caracter) => {
          const entidades: Record<string, string> = {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          };

          return entidades[caracter];
        });
      }

      function mostrarMensaje(
        elemento: HTMLElement,
        mensaje: string,
        tipo: "error" | "success"
      ) {
        elemento.textContent = mensaje;
        elemento.className = `message message-${tipo}`;
        elemento.hidden = false;
      }

      function ocultarMensaje(elemento: HTMLElement) {
        elemento.hidden = true;
        elemento.textContent = "";
      }

      async function peticion<T>(
        ruta: string,
        opciones: RequestInit = {}
      ): Promise<T> {
        let respuesta: Response;

        try {
          respuesta = await fetch(`${API_URL}${ruta}`, {
            ...opciones,
            headers: {
              "Content-Type": "application/json",
              ...opciones.headers,
            },
          });
        } catch {
          throw new Error(
            "No fue posible conectar con la API. Comprueba que el servidor esté disponible y que CORS esté configurado."
          );
        }

        if (!respuesta.ok) {
          let mensaje = `Error del servidor (${respuesta.status}).`;

          try {
            const cuerpo = await respuesta.json();

            if (typeof cuerpo.detail === "string") {
              mensaje = cuerpo.detail;
            } else if (Array.isArray(cuerpo.detail)) {
              mensaje = cuerpo.detail
                .map((error: { msg?: string }) => error.msg ?? "Dato inválido")
                .join(". ");
            }
          } catch {
            // La respuesta de error no contiene JSON válido.
          }

          throw new Error(mensaje);
        }

        if (respuesta.status === 204) {
          return undefined as T;
        }

        const texto = await respuesta.text();

        if (!texto) {
          return undefined as T;
        }

        try {
          return JSON.parse(texto) as T;
        } catch {
          throw new Error("La API devolvió una respuesta que no es JSON válido.");
        }
      }

      function fechaLegible(fecha: string): string {
        const valor = new Date(fecha);

        if (Number.isNaN(valor.getTime())) {
          return "Fecha no disponible";
        }

        return valor.toLocaleString("es-CO", {
          dateStyle: "medium",
          timeStyle: "short",
        });
      }

      function actualizarEstadisticas() {
        obtener<HTMLElement>("#totalCount").textContent =
          String(solicitudes.length);

        obtener<HTMLElement>("#pendingCount").textContent = String(
          solicitudes.filter((s) => s.estado === "pendiente").length
        );

        obtener<HTMLElement>("#acceptedCount").textContent = String(
          solicitudes.filter((s) => s.estado === "aceptada").length
        );
      }

      function etiquetaEstado(estado: Estado): string {
        const estados: Record<
          Estado,
          { nombre: string; simbolo: string }
        > = {
          pendiente: { nombre: "Pendiente", simbolo: "◷" },
          aceptada: { nombre: "Aceptada", simbolo: "✓" },
          rechazada: { nombre: "Rechazada", simbolo: "×" },
        };

        const dato = estados[estado];

        return `
          <span class="status-badge status-${estado}">
            <span aria-hidden="true">${dato.simbolo}</span>
            ${dato.nombre}
          </span>`;
      }

      function inicialesNombre(nombre: string): string {
        return nombre
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map((parte) => parte.charAt(0))
          .join("")
          .toUpperCase() || "?";
      }

     
function renderizarSolicitudes() {
  const filtro = statusFilter.value as Estado | "";
  const filtradas = filtro
    ? solicitudes.filter((s) => s.estado === filtro)
    : solicitudes;

  actualizarEstadisticas();

  resultsCount.textContent = `${filtradas.length} ${
    filtradas.length === 1 ? "solicitud" : "solicitudes"
  }`;

  if (filtradas.length === 0) {
    applicationsList.innerHTML = `
      <div class="table-empty">
        <span aria-hidden="true">▤</span>
        <h3>${filtro ? "No hay resultados para este estado" : "Todavía no hay solicitudes"}</h3>
        <p>${
          filtro
            ? "Selecciona otro estado para consultar más solicitudes."
            : "Las solicitudes registradas aparecerán aquí."
        }</p>
      </div>`;
    return;
  }

  const filas = filtradas.map((s) => {
    const acciones = s.estado === "pendiente"
      ? `
        <div class="table-actions">
          <button
            type="button"
            class="table-action accept-action"
            data-id="${s.id}"
            data-estado="aceptada"
            aria-label="Aceptar solicitud ${s.id}"
            title="Aceptar solicitud"
          >✓</button>
          <button
            type="button"
            class="table-action reject-action"
            data-id="${s.id}"
            data-estado="rechazada"
            aria-label="Rechazar solicitud ${s.id}"
            title="Rechazar solicitud"
          >×</button>
        </div>`
      : `<span class="completed-label">${
          s.estado === "aceptada" ? "Finalizada: aceptada" : "Finalizada: rechazada"
        }</span>`;

    return `
      <tr>
        <td class="id-cell">#${s.id}</td>
        <td>
          <div class="table-person">
            <span class="table-avatar">${escapar(inicialesNombre(s.nombre))}</span>
            <div class="table-person-info">
              <strong>${escapar(s.nombre)}</strong>
              <a href="mailto:${escapar(s.correo)}">${escapar(s.correo)}</a>
            </div>
          </div>
        </td>
        <td class="phone-cell">${
          s.telefono
            ? `<a href="tel:${escapar(s.telefono.replace(/[^\d+*#]/g, ""))}">${escapar(s.telefono)}</a>`
            : '<span class="muted-cell">No indicado</span>'
        }</td>
        <td>
          <span class="status-badge status-${s.estado}">
            <span class="status-indicator"></span>
            ${s.estado === "pendiente" ? "Pendiente" : s.estado === "aceptada" ? "Aceptada" : "Rechazada"}
          </span>
        </td>
        <td class="date-cell">${escapar(fechaLegible(s.fecha_solicitud))}</td>
        <td class="actions-cell">${acciones}</td>
        <td class="experience-cell">
          ${escapar(s.experiencia?.trim() || "Sin información adicional")}
        </td>
      </tr>`;
  }).join("");

  applicationsList.innerHTML = `
    <div class="table-scroll">
      <table class="applications-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>PERSONA</th>
            <th>TELÉFONO</th>
            <th>ESTADO</th>
            <th>FECHA</th>
            <th>ACCIONES</th>
            <th>EXPERIENCIA</th>
          </tr>
        </thead>
        <tbody>${filas}</tbody>
      </table>
    </div>`;
}


      async function cargarSolicitudes() {
        if (cargando) return;

        cargando = true;
        refreshButton.disabled = true;
        refreshButton.setAttribute("aria-busy", "true");
        ocultarMensaje(listMessage);

        try {
          const resultado = await peticion<Solicitud[]>("/solicitudes");

          if (!Array.isArray(resultado)) {
            throw new Error("La API no devolvió una lista de solicitudes válida.");
          }

          solicitudes = resultado;
          renderizarSolicitudes();

          lastUpdated.textContent = `ACTUALIZADO ${new Date()
            .toLocaleTimeString("es-CO", {
              hour: "2-digit",
              minute: "2-digit",
            })}`;
        } catch (error) {
          applicationsList.innerHTML = `
            <div class="empty-state error-state">
              <span class="empty-icon" aria-hidden="true">!</span>
              <h3>No se pudieron cargar los registros</h3>
              <p>${escapar(
                error instanceof Error
                  ? error.message
                  : "Ocurrió un error desconocido."
              )}</p>
              <button
                class="button button-secondary retry-button"
                type="button"
                id="retryButton"
              >
                Intentar de nuevo
              </button>
            </div>`;

          resultsCount.textContent = "Error de conexión";
          lastUpdated.textContent = "SIN CONEXIÓN";

          obtener<HTMLElement>("#totalCount").textContent = "—";
          obtener<HTMLElement>("#pendingCount").textContent = "—";
          obtener<HTMLElement>("#acceptedCount").textContent = "—";

          obtener<HTMLButtonElement>("#retryButton")
            .addEventListener("click", cargarSolicitudes);
        } finally {
          cargando = false;
          refreshButton.disabled = false;
          refreshButton.removeAttribute("aria-busy");
        }
      }

      form.addEventListener("submit", async (evento) => {
        evento.preventDefault();

        if (enviando) return;

        enviando = true;
        submitButton.disabled = true;
        submitButton.setAttribute("aria-busy", "true");
        ocultarMensaje(formMessage);

        const datos = new FormData(form);

        const nuevaSolicitud = {
          nombre: String(datos.get("nombre") ?? "").trim(),
          correo: String(datos.get("correo") ?? "").trim(),
          telefono: String(datos.get("telefono") ?? "").trim() || null,
          experiencia: String(datos.get("experiencia") ?? "").trim() || null,
        };

        try {
          await peticion("/solicitudes", {
            method: "POST",
            body: JSON.stringify(nuevaSolicitud),
          });

          form.reset();
          mostrarMensaje(
            formMessage,
            "La solicitud se registró correctamente.",
            "success"
          );

          statusFilter.value = "";
          await cargarSolicitudes();
        } catch (error) {
          mostrarMensaje(
            formMessage,
            error instanceof Error
              ? error.message
              : "No fue posible registrar la solicitud.",
            "error"
          );
        } finally {
          enviando = false;
          submitButton.disabled = false;
          submitButton.removeAttribute("aria-busy");
        }
      });

      applicationsList.addEventListener("click", async (evento) => {
        const objetivo = evento.target;

        if (!(objetivo instanceof Element)) return;

        const boton = objetivo.closest<HTMLButtonElement>(
          "button[data-id][data-estado]"
        );

        if (!boton || actualizandoEstado || cargando) return;

        const id = Number(boton.dataset.id);
        const estado = boton.dataset.estado as Estado;

        if (
          !Number.isInteger(id) ||
          id < 1 ||
          (estado !== "aceptada" && estado !== "rechazada")
        ) {
          return;
        }

        const solicitud = solicitudes.find((s) => s.id === id);

        if (!solicitud || solicitud.estado !== "pendiente") return;

        const accion = estado === "aceptada" ? "aceptar" : "rechazar";

        const confirmar = window.confirm(
          `¿Deseas ${accion} la solicitud de ${solicitud.nombre}?`
        );

        if (!confirmar) return;

        actualizandoEstado = true;

        applicationsList
          .querySelectorAll<HTMLButtonElement>("button[data-id]")
          .forEach((b) => {
            b.disabled = true;
          });

        ocultarMensaje(listMessage);

        try {
          await peticion(`/solicitudes/${id}/estado`, {
            method: "PATCH",
            body: JSON.stringify({ estado }),
          });

          solicitudes = solicitudes.map((s) =>
            s.id === id ? { ...s, estado } : s
          );

          renderizarSolicitudes();

          mostrarMensaje(
            listMessage,
            `La solicitud #${id} fue ${
              estado === "aceptada" ? "aceptada" : "rechazada"
            } correctamente.`,
            "success"
          );
        } catch (error) {
          mostrarMensaje(
            listMessage,
            error instanceof Error
              ? error.message
              : "No fue posible actualizar el estado.",
            "error"
          );
        } finally {
          actualizandoEstado = false;
        }
      });

      statusFilter.addEventListener("change", renderizarSolicitudes);
      refreshButton.addEventListener("click", cargarSolicitudes);

      cargarSolicitudes();
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }


      

      :global(html) {
        min-width: 320px;
        background: #0b0a0f;
        color-scheme: dark;
      }

      :global(body) {
        margin: 0;
        background:
          radial-gradient(ellipse at 50% -20%, #24172f 0%, transparent 48%),
          #0b0a0f;
        color: #eeebf3;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system,
          BlinkMacSystemFont, "Segoe UI", sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      :global(button),
      :global(input),
      :global(textarea),
      :global(select) {
        font: inherit;
      }

      :global(button:focus-visible),
      :global(a:focus-visible),
      :global(input:focus-visible),
      :global(textarea:focus-visible),
      :global(select:focus-visible) {
        outline: 2px solid #c4a1ff;
        outline-offset: 3px;
      }

      .app {
        --panel: #121116;
        --panel-soft: #17151c;
        --line: #2b2732;
        --muted: #9892a3;
        --purple: #c4a1ff;
        --green: #8cddb0;
        --yellow: #edc47d;
        --red: #f29a9a;
        width: min(1440px, calc(100% - 64px));
        min-height: 100vh;
        margin-inline: auto;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 88px;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: inherit;
        text-decoration: none;
      }

      .brand-mark {
        display: grid;
        width: 43px;
        height: 43px;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid #5b486f;
        border-radius: 9px;
        background: linear-gradient(145deg, #32243f, #17131d);
        color: #e2ceff;
        font-size: 21px;
        font-weight: 850;
      }

      .brand-copy strong,
      .brand-copy small {
        display: block;
      }

      .brand-copy strong {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.25px;
      }

      .brand-copy small {
        margin-top: 5px;
        color: var(--muted);
        font-size: 9px;
        letter-spacing: 1.7px;
      }

      .topbar-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: #aaa2b7;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
        letter-spacing: 1px;
      }

      .online-dot {
        width: 7px;
        height: 7px;
        flex: 0 0 auto;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 10px #8cddb055;
      }

      main {
        padding: 56px 0 76px;
      }

      .hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 28px;
        margin-bottom: 34px;
      }

      .eyebrow,
      .section-index,
      .stat-label,
      .detail-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
        font-weight: 650;
        letter-spacing: 1.25px;
      }

      .eyebrow {
        color: var(--purple);
      }

      .hero h1 {
        margin: 14px 0 12px;
        color: #f8f5fc;
        font-size: clamp(36px, 5vw, 56px);
        font-weight: 780;
        letter-spacing: -2.8px;
        line-height: 1.05;
      }

      .accent {
        color: var(--purple);
      }

      .hero p {
        max-width: 570px;
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.9;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 42px;
        padding: 11px 15px;
        border: 1px solid transparent;
        border-radius: 7px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        transition:
          background 0.18s ease,
          border-color 0.18s ease,
          transform 0.18s ease;
      }

      .button:hover:not(:disabled) {
        transform: translateY(-1px);
      }

      .button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
      }

      .button-secondary {
        flex: 0 0 auto;
        border-color: #38313f;
        background: #17151c;
        color: #e6e0ed;
      }

      .button-secondary:hover:not(:disabled) {
        border-color: #6a5482;
        background: #211b29;
      }

      .button-primary {
        border-color: #c9a9ff;
        background: var(--purple);
        color: #21172c;
      }

      .button-primary:hover:not(:disabled) {
        background: #d6bdff;
      }

      .button-full {
        width: 100%;
        min-height: 46px;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 26px;
      }

      .stat-card {
        min-width: 0;
        padding: 22px 23px;
        border: 1px solid var(--line);
        border-radius: 11px;
        background: linear-gradient(145deg, #17151c, #111015);
        box-shadow: 0 10px 35px #0000000b;
      }

      .stat-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .stat-label {
        color: var(--muted);
        font-size: 9px;
      }

      .stat-icon {
        display: grid;
        width: 34px;
        height: 34px;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid;
        border-radius: 9px;
        font-size: 15px;
      }

      .icon-purple {
        border-color: #514064;
        background: #251c30;
        color: var(--purple);
      }

      .icon-yellow {
        border-color: #5b4930;
        background: #292115;
        color: var(--yellow);
      }

      .icon-green {
        border-color: #315640;
        background: #17251c;
        color: var(--green);
      }

      .stat-number {
        display: block;
        margin-top: 17px;
        color: #f8f5fc;
        font-size: 34px;
        font-weight: 720;
        letter-spacing: -1.2px;
        line-height: 1.2;
      }

      .stat-description {
        display: block;
        margin-top: 7px;
        color: var(--muted);
        font-size: 11px;
      }

      .workspace {
        display: grid;
        grid-template-columns: minmax(280px, 350px) minmax(0, 1fr);
        align-items: start;
        gap: 20px;
      }

      .panel {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--panel);
        box-shadow: 0 16px 48px #00000012;
      }

      .form-panel {
        padding: 25px;
      }

      .panel-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 26px;
      }

      .section-index {
        color: var(--purple);
        font-size: 9px;
      }

      .panel-heading h2 {
        margin: 11px 0 7px;
        color: #f5f1fa;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.4px;
      }

      .panel-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      .heading-icon {
        display: grid;
        width: 37px;
        height: 37px;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid #514064;
        border-radius: 9px;
        background: #251c30;
        color: var(--purple);
        font-size: 23px;
      }

      .field {
        margin-bottom: 20px;
      }

      .field label {
        display: block;
        margin-bottom: 9px;
        color: #e0dbe7;
        font-size: 11px;
        font-weight: 650;
      }

      .required {
        color: var(--purple);
      }

      .field input,
      .field textarea,
      .list-toolbar select {
        display: block;
        width: 100%;
        min-width: 0;
        border: 1px solid #35303d;
        border-radius: 7px;
        outline: none;
        background: #0d0c10;
        color: #f0ebf6;
        font-size: 12px;
        transition:
          border-color 0.18s ease,
          box-shadow 0.18s ease;
      }

      .field input,
      .field textarea {
        padding: 12px 13px;
      }

      .field input {
        min-height: 43px;
      }

      .field textarea {
        min-height: 120px;
        resize: vertical;
        line-height: 1.8;
      }

      .field input::placeholder,
      .field textarea::placeholder {
        color: #70697a;
      }

      .field input:focus,
      .field textarea:focus,
      .list-toolbar select:focus {
        border-color: #8d6bb9;
        box-shadow: 0 0 0 3px #c4a1ff13;
      }

      .field-hint {
        display: block;
        margin-top: 8px;
        color: #777180;
        font-size: 10px;
        line-height: 1.7;
      }

      .form-note {
        margin: 13px 0 0;
        color: #898292;
        font-size: 10px;
        line-height: 1.7;
      }

      .message {
        margin-bottom: 15px;
        padding: 12px 13px;
        border: 1px solid;
        border-radius: 7px;
        font-size: 11px;
        line-height: 1.8;
        overflow-wrap: anywhere;
      }

      .message[hidden] {
        display: none;
      }

      .message-error {
        border-color: #66383c;
        background: #27171a;
        color: #ffb4b4;
      }

      .message-success {
        border-color: #315640;
        background: #17251c;
        color: #a7e7bd;
      }

      .applications-heading {
        align-items: center;
        margin: 0;
        padding: 25px 26px;
      }

      .results-counter {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        flex: 0 0 auto;
        padding: 9px 11px;
        border: 1px solid #34303c;
        border-radius: 7px;
        background: #19161e;
        color: #d9d2e2;
        font-size: 10px;
        white-space: nowrap;
      }

      .list-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 17px 26px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        background: #0e0d11;
      }

      .filter-copy {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
      }

      .filter-copy label {
        color: #e1dbe9;
        font-size: 11px;
        font-weight: 650;
      }

      .filter-copy span {
        color: var(--muted);
        font-size: 10px;
        line-height: 1.7;
      }

      .list-toolbar select {
        width: auto;
        max-width: 48%;
        min-height: 39px;
        padding: 9px 12px;
        cursor: pointer;
      }

      .list-message {
        margin: 16px 22px 0;
      }

      .applications-list {
        min-height: 230px;
      }

      .application-card {
        padding: 25px 26px;
        border-bottom: 1px solid var(--line);
        transition: background 0.18s ease;
      }

      .application-card:last-child {
        border-bottom: 0;
      }

      .application-card:hover {
        background: #17141c;
      }

      .application-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .applicant {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
      }

      .applicant-avatar {
        display: grid;
        width: 49px;
        height: 49px;
        flex: 0 0 49px;
        place-items: center;
        border: 1px solid #514064;
        border-radius: 11px;
        background: linear-gradient(145deg, #352544, #1b1523);
        color: #e1ceff;
        font-size: 15px;
        font-weight: 750;
      }

      .applicant-identity {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        min-width: 0;
      }

      .applicant-identity h3 {
        margin: 0;
        color: #f6f2fb;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.5;
        overflow-wrap: anywhere;
      }

      .email-link {
        color: #bda7e0;
        font-size: 11px;
        line-height: 1.6;
        overflow-wrap: anywhere;
        text-decoration: none;
      }

      .email-link:hover {
        color: #e0cfff;
        text-decoration: underline;
      }

      .application-id {
        margin-top: 3px;
        color: #93899f;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        letter-spacing: 0.8px;
      }

      .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex: 0 0 auto;
        padding: 7px 10px;
        border: 1px solid;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 650;
        white-space: nowrap;
      }

      .status-pendiente {
        border-color: #5a482e;
        background: #292115;
        color: var(--yellow);
      }

      .status-aceptada {
        border-color: #315640;
        background: #17251c;
        color: var(--green);
      }

      .status-rechazada {
        border-color: #66383c;
        background: #291719;
        color: var(--red);
      }

      .application-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 22px;
        padding: 18px;
        border: 1px solid #302b37;
        border-radius: 9px;
        background: #0d0c10;
      }

      .detail-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
      }

      .detail-label {
        color: #91899d;
        font-size: 9px;
        letter-spacing: 1px;
        line-height: 1.6;
      }

      .detail-value {
        color: #ded8e7;
        font-size: 11px;
        line-height: 1.8;
        overflow-wrap: anywhere;
      }

      .detail-value a {
        color: #c7a8ff;
        text-decoration: none;
      }

      .detail-value a:hover {
        text-decoration: underline;
      }

      .detail-experience {
        grid-column: 1 / -1;
        padding-top: 16px;
        border-top: 1px solid #302b37;
      }

      .detail-experience p {
        margin: 0;
        padding: 13px 15px;
        border-left: 3px solid #8662ad;
        border-radius: 0 7px 7px 0;
        background: #18141d;
        color: #d4cddd;
        font-size: 11px;
        line-height: 1.9;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
      }

      .application-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 19px;
      }

      .button-accept {
        border-color: #315640;
        background: #17251c;
        color: var(--green);
      }

      .button-accept:hover:not(:disabled) {
        background: #203829;
      }

      .button-reject {
        border-color: #66383c;
        background: #291719;
        color: var(--red);
      }

      .button-reject:hover:not(:disabled) {
        background: #3a2024;
      }

      .final-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 19px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 7px;
        background: #19161e;
        font-size: 11px;
      }

      .final-aceptada {
        color: var(--green);
      }

      .final-rechazada {
        color: var(--red);
      }

      .empty-state {
        display: flex;
        min-height: 270px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 38px 25px;
        text-align: center;
      }

      .empty-icon {
        display: grid;
        width: 46px;
        height: 46px;
        place-items: center;
        margin-bottom: 17px;
        border: 1px solid #494052;
        border-radius: 12px;
        background: #1b1622;
        color: var(--purple);
        font-size: 23px;
      }

      .empty-state h3 {
        margin: 0;
        color: #eee8f5;
        font-size: 14px;
        font-weight: 700;
      }

      .empty-state p {
        max-width: 350px;
        margin: 10px 0 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
        overflow-wrap: anywhere;
      }

      .error-state .empty-icon {
        border-color: #66383c;
        background: #291719;
        color: var(--red);
      }

      .retry-button {
        margin-top: 19px;
      }

      .loading-spinner {
        width: 30px;
        height: 30px;
        margin-bottom: 20px;
        border: 2px solid #393044;
        border-top-color: var(--purple);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      .list-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 15px 25px;
        border-top: 1px solid var(--line);
        background: #0e0d11;
        color: #827a8d;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        letter-spacing: 0.7px;
      }

      .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        padding: 25px 0 30px;
        border-top: 1px solid var(--line);
      }

      .footer-brand .brand-mark {
        width: 37px;
        height: 37px;
        font-size: 17px;
      }

      .footer-brand .brand-copy strong {
        font-size: 9px;
      }

      .footer-brand .brand-copy small {
        font-size: 8px;
      }

      .footer p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      @media (min-width: 1200px) {
        .application-details {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 1050px) {
        .workspace {
          grid-template-columns: minmax(0, 1fr);
        }

        .form-panel {
          padding: 25px;
        }

        .workspace .form-panel form {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          column-gap: 18px;
        }

        .workspace .form-panel .panel-heading,
        .workspace .form-panel .message,
        .workspace .form-panel .button-full,
        .workspace .form-panel .form-note {
          grid-column: 1 / -1;
        }

        .workspace .form-panel .panel-heading {
          margin-bottom: 23px;
        }
      }

      @media (max-width: 650px) {
        .app {
          width: calc(100% - 30px);
        }

        .topbar {
          min-height: 76px;
          gap: 10px;
        }

        .brand {
          gap: 9px;
        }

        .brand-mark {
          width: 36px;
          height: 36px;
          border-radius: 8px;
          font-size: 18px;
        }

        .brand-copy strong {
          font-size: 9px;
          letter-spacing: 0.7px;
        }

        .brand-copy small {
          font-size: 7px;
          letter-spacing: 1px;
        }

        .topbar-label {
          gap: 6px;
          font-size: 8px;
          letter-spacing: 0;
          text-align: right;
        }

        main {
          padding: 36px 0 45px;
        }

        .hero {
          align-items: stretch;
          flex-direction: column;
          gap: 20px;
          margin-bottom: 24px;
        }

        .hero h1 {
          margin-top: 12px;
          font-size: 39px;
          letter-spacing: -1.8px;
        }

        .hero p {
          font-size: 12px;
        }

        .hero > .button {
          width: 100%;
        }

        .stats-grid {
          gap: 9px;
          margin-bottom: 19px;
        }

        .stat-card {
          padding: 13px 11px;
          border-radius: 9px;
        }

        .stat-label {
          font-size: 8px;
          letter-spacing: 0;
          line-height: 1.5;
        }

        .stat-icon {
          width: 25px;
          height: 25px;
          border-radius: 6px;
          font-size: 12px;
        }

        .stat-number {
          margin-top: 14px;
          font-size: 27px;
        }

        .stat-description {
          font-size: 9px;
          line-height: 1.6;
        }

        .workspace {
          gap: 17px;
        }

        .form-panel {
          padding: 19px;
        }

        .workspace .form-panel form {
          display: block;
        }

        .applications-heading {
          align-items: flex-start;
          flex-direction: column;
          padding: 21px 18px;
          gap: 16px;
        }

        .applications-heading .panel-heading p {
          max-width: 300px;
        }

        .list-toolbar {
          align-items: stretch;
          flex-direction: column;
          gap: 13px;
          padding: 16px 18px;
        }

        .list-toolbar select {
          width: 100%;
          max-width: none;
        }

        .application-card {
          padding: 21px 17px;
        }

        .application-top {
          align-items: flex-start;
          flex-direction: column;
          gap: 15px;
        }

        .applicant {
          align-items: flex-start;
          gap: 11px;
          width: 100%;
        }

        .applicant-avatar {
          width: 42px;
          height: 42px;
          flex-basis: 42px;
          border-radius: 9px;
          font-size: 13px;
        }

        .applicant-identity h3 {
          font-size: 13px;
        }

        .email-link {
          font-size: 10px;
        }

        .status-badge {
          padding: 6px 9px;
        }

        .application-details {
          grid-template-columns: minmax(0, 1fr);
          gap: 16px;
          margin-top: 19px;
          padding: 15px;
        }

        .detail-experience {
          grid-column: auto;
        }

        .application-actions {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 9px;
        }

        .application-actions .button {
          width: 100%;
        }

        .list-message {
          margin-inline: 14px;
        }

        .list-footer {
          padding: 13px 15px;
          font-size: 8px;
          letter-spacing: 0;
        }

        .footer {
          align-items: flex-start;
          flex-direction: column;
          gap: 15px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }



/* Tabla de solicitudes */
.applications-list {
  min-width: 0;
  min-height: 0;
  display: block;
}

.table-scroll {
  width: 100%;
  overflow-x: auto;
  overscroll-behavior-x: contain;
}

.applications-table {
  width: 100%;
  min-width: 1000px;
  border-collapse: collapse;
  text-align: left;
  font-size: 12px;
}

.applications-table thead {
  background: #19161f;
}

.applications-table th {
  padding: 15px 14px;
  border-bottom: 1px solid #39313f;
  color: #aaa0b8;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.8px;
  white-space: nowrap;
}

.applications-table td {
  padding: 16px 14px;
  border-bottom: 1px solid #2b2732;
  color: #ded8e7;
  vertical-align: middle;
}

.applications-table tbody tr {
  background: #121116;
  transition: background 0.15s ease;
}

.applications-table tbody tr:hover {
  background: #1b1721;
}

.applications-table tbody tr:last-child td {
  border-bottom: 0;
}

.id-cell {
  color: #bba3dc !important;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  white-space: nowrap;
}

.table-person {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 220px;
}

.table-avatar {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  place-items: center;
  border: 1px solid #514064;
  border-radius: 8px;
  background: #281e32;
  color: #ddc7ff;
  font-size: 11px;
  font-weight: 750;
}

.table-person-info {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}

.table-person-info strong {
  color: #f1edf6;
  font-size: 12px;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.table-person-info a,
.phone-cell a {
  color: #bca3e0;
  font-size: 11px;
  text-decoration: none;
  overflow-wrap: anywhere;
}

.table-person-info a:hover,
.phone-cell a:hover {
  text-decoration: underline;
}

.phone-cell {
  white-space: nowrap;
}

.muted-cell {
  color: #837b8e;
}

.applications-table .status-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 9px;
  border: 1px solid;
  border-radius: 20px;
  font-size: 10px;
  white-space: nowrap;
}

.status-indicator {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
  background: currentColor;
}

.applications-table .status-pendiente {
  border-color: #5a482e;
  background: #292115;
  color: #edc47d;
}

.applications-table .status-aceptada {
  border-color: #315640;
  background: #17251c;
  color: #8cddb0;
