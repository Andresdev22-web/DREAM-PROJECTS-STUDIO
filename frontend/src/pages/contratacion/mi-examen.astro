1
---
import "../../style/global.css";

const API_URL = "https://dreamprojectsstudioapi.nanadev.online";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Consulta tu solicitud, realiza tu examen y revisa tu calificación en DREAM PROJECTS STUDIO."
    />
    <title>Mi solicitud y examen | DREAM PROJECTS STUDIO</title>
  </head>

  <body class="min-h-screen bg-[#080808] text-white antialiased">
    <main class="mx-auto flex min-h-screen w-full max-w-4xl items-center justify-center px-4 py-12 sm:px-6">
      <section class="w-full overflow-hidden rounded-2xl border border-white/10 bg-[#111111] shadow-2xl shadow-black/30">

        <!-- Encabezado -->
        <header class="border-b border-white/10 px-6 py-7 sm:px-9">
          <a
            href="/"
            class="text-xs font-bold tracking-[0.2em] text-[#FF1744]"
          >
            DREAM PROJECTS STUDIO
          </a>

          <h1 class="mt-5 text-2xl font-bold tracking-tight sm:text-3xl">
            Mi solicitud y examen
          </h1>

          <p class="mt-2 max-w-xl text-sm leading-6 text-gray-400">
            Consulta los datos de tu solicitud, realiza tu examen si todavía
            no lo has completado y revisa tu calificación.
          </p>
        </header>

        <div class="space-y-6 p-6 sm:p-9">

          <!-- Cargando -->
          <div
            id="estado-carga"
            class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] p-4"
            role="status"
          >
            <span class="h-5 w-5 animate-spin rounded-full border-2 border-white/20 border-t-[#FF1744]"></span>
            <p class="text-sm text-gray-300">
              Consultando tu información...
            </p>
          </div>

          <!-- Mensajes -->
          <div
            id="mensaje"
            class="hidden whitespace-pre-wrap rounded-xl border p-4 text-sm leading-6"
            role="status"
            aria-live="polite"
          ></div>

          <!-- Contenido principal -->
          <div id="contenido-solicitud" class="hidden space-y-6">

            <!-- Estado de la solicitud -->
            <section class="rounded-xl border border-white/10 bg-black/20 p-5 sm:p-6">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                    Estado de la postulación
                  </p>

                  <span
                    id="estado-badge"
                    class="mt-3 inline-flex rounded-full border px-3 py-1.5 text-sm font-semibold"
                  >
                    Consultando...
                  </span>
                </div>

                <div class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 sm:text-right">
                  <p class="text-xs text-gray-500">Número de solicitud</p>
                  <p id="solicitud-id" class="mt-1 font-mono text-sm text-gray-200">
                    —
                  </p>
                </div>
              </div>
            </section>

            <!-- Datos personales y de perfil -->
            <section>
              <h2 class="mb-4 text-lg font-bold">Información de tu solicitud</h2>

              <div class="grid gap-4 sm:grid-cols-2">

                <article class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    Nombre
                  </p>
                  <p id="nombre" class="mt-2 break-words font-medium text-white">
                    —
                  </p>
                </article>

                <article class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    Usuario de Roblox
                  </p>
                  <p id="roblox" class="mt-2 break-words font-medium text-white">
                    —
                  </p>
                </article>

                <article class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    Correo electrónico
                  </p>
                  <p id="correo" class="mt-2 break-all text-sm text-gray-200">
                    —
                  </p>
                </article>

                <article class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    Puesto solicitado
                  </p>
                  <p id="puesto" class="mt-2 break-words font-medium text-white">
                    —
                  </p>
                </article>

                <article class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    Nivel de experiencia
                  </p>
                  <p id="experiencia" class="mt-2 text-sm text-gray-200">
                    —
                  </p>
                </article>

                <article class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    Fecha de solicitud
                  </p>
                  <p id="fecha" class="mt-2 text-sm text-gray-200">
                    —
                  </p>
                </article>

              </div>
            </section>

            <!-- Examen -->
            <section class="rounded-xl border border-white/10 bg-black/20 p-5 sm:p-6">
              <div class="flex items-start gap-3">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#FF1744]/10 text-[#FF1744]">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M8 6h13" />
                    <path d="M8 12h13" />
                    <path d="M8 18h13" />
                    <path d="m3 6 1 1 2-2" />
                    <path d="m3 12 1 1 2-2" />
                    <path d="m3 18 1 1 2-2" />
                  </svg>
                </div>

                <div>
                  <h2 class="font-semibold text-white">
                    Examen de selección
                  </h2>

                  <p id="texto-examen" class="mt-2 text-sm leading-6 text-gray-400">
                    Comprobando el estado de tu examen...
                  </p>
                </div>
              </div>

              <!-- Resultado del examen -->
              <div
                id="resultado-examen"
                class="mt-5 hidden rounded-xl border border-green-500/20 bg-green-500/[0.05] p-5"
              >
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                  Tu calificación
                </p>

                <p
                  id="puntaje-examen"
                  class="mt-2 text-3xl font-bold text-white"
                >
                  —
                </p>

                <p
                  id="detalle-puntaje"
                  class="mt-2 text-sm leading-6 text-gray-400"
                >
                  Resultado registrado por la plataforma.
                </p>
              </div>

              <!-- Disponible solo si no ha completado el examen -->
              <button
                id="ir-examen"
                type="button"
                hidden
                class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#FF1744] px-5 py-3.5 text-sm font-bold text-white transition hover:bg-[#e6143d] focus:outline-none focus:ring-2 focus:ring-[#FF1744] focus:ring-offset-2 focus:ring-offset-[#111111] sm:w-auto"
              >
                Realizar examen

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </button>
            </section>
          </div>

          <footer class="border-t border-white/10 pt-5">
            <a
              href="/"
              class="text-sm text-gray-400 transition hover:text-white"
            >
              ← Volver al inicio
            </a>
          </footer>
        </div>
      </section>
    </main>

    <script define:vars={{ API_URL }}>
      const mensaje = document.querySelector("#mensaje");
      const estadoCarga = document.querySelector("#estado-carga");
      const contenidoSolicitud = document.querySelector("#contenido-solicitud");
      const estadoBadge = document.querySelector("#estado-badge");
      const botonExamen = document.querySelector("#ir-examen");
      const textoExamen = document.querySelector("#texto-examen");
      const resultadoExamen = document.querySelector("#resultado-examen");
      const puntajeExamen = document.querySelector("#puntaje-examen");
      const detallePuntaje = document.querySelector("#detalle-puntaje");

      let urlExamen = "";

      function mostrarMensaje(texto, tipo = "info") {
        mensaje.textContent = texto;
        mensaje.className =
          "whitespace-pre-wrap rounded-xl border p-4 text-sm leading-6 " +
          (tipo === "error"
            ? "border-red-500/30 bg-red-500/10 text-red-300"
            : "border-white/10 bg-white/[0.03] text-gray-300");
      }

      function mostrarValor(id, valor) {
        const elemento = document.getElementById(id);

        if (!elemento) return;

        elemento.textContent =
          valor !== null &&
          valor !== undefined &&
          String(valor).trim() !== ""
            ? String(valor)
            : "No proporcionado";
      }

      function normalizarEstado(estado) {
        return String(estado ?? "").trim().toUpperCase();
      }

      function mostrarEstado(estado) {
        const estadoNormalizado = normalizarEstado(estado);

        const estados = {
          PENDIENTE: {
            texto: "Pendiente de revisión",
            clases: "border-yellow-500/30 bg-yellow-500/10 text-yellow-300",
          },
          ACEPTADA: {
            texto: "Solicitud aceptada",
            clases: "border-green-500/30 bg-green-500/10 text-green-300",
          },
          RECHAZADA: {
            texto: "Solicitud rechazada",
            clases: "border-red-500/30 bg-red-500/10 text-red-300",
          },
        };

        const configuracion = estados[estadoNormalizado] || {
          texto: estado || "Estado no disponible",
          clases: "border-white/10 bg-white/5 text-gray-300",
        };

        estadoBadge.textContent = configuracion.texto;
        estadoBadge.className =
          "mt-3 inline-flex rounded-full border px-3 py-1.5 text-sm font-semibold " +
          configuracion.clases;
      }

      function formatearFecha(fecha) {
        if (!fecha) return "No disponible";

        const fechaValida = new Date(fecha);

        if (Number.isNaN(fechaValida.getTime())) {
          return String(fecha);
        }

        return fechaValida.toLocaleDateString("es-CO", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      }

      function interpretarBooleano(valor) {
        return (
          valor === true ||
          valor === 1 ||
          valor === "1" ||
          String(valor).toLowerCase() === "true"
        );
      }

      function obtenerPuntaje(solicitud, examen) {
        // Se aceptan algunos nombres alternativos por si la API
        // devuelve el puntaje con un nombre diferente.
        const valores = [
          solicitud.puntaje_examen,
          solicitud.calificacion_examen,
          solicitud.exam_score,
          solicitud.score,
          examen?.puntaje,
          examen?.calificacion,
          examen?.score,
        ];

        return valores.find(
          (valor) =>
            valor !== null &&
            valor !== undefined &&
            valor !== ""
        );
      }

      function obtenerEstadoExamen(solicitud, examen) {
        const indicadores = [
          solicitud.examen_completado,
          solicitud.exam_completed,
          examen?.completado,
          examen?.completed,
        ];

        return indicadores.some(interpretarBooleano);
      }

      async function consultarSolicitud() {
        estadoCarga.classList.remove("hidden");
        mensaje.classList.add("hidden");
        contenidoSolicitud.classList.add("hidden");
        resultadoExamen.classList.add("hidden");
        botonExamen.hidden = true;
        urlExamen = "";

        const token = localStorage.getItem("api_access_token");

        if (!token) {
          estadoCarga.classList.add("hidden");
          mostrarMensaje(
            "Debes iniciar sesión para consultar tu solicitud y tu examen.",
            "error"
          );
          return;
        }

        try {
          const response = await fetch(
            `${API_URL.replace(/\/+$/, "")}/solicitudes/mia`,
            {
              method: "GET",
              headers: {
                Authorization: `Bearer ${token}`,
                Accept: "application/json",
              },
            }
          );

          const respuesta = await response.json().catch(() => null);

          if (!response.ok) {
            throw new Error(
              respuesta?.detail ||
              respuesta?.mensaje ||
              `No se pudo consultar tu solicitud. Error HTTP ${response.status}.`
            );
          }

          // La API puede devolver la solicitud directamente o dentro
          // de una propiedad llamada "solicitud".
          const solicitud = respuesta?.solicitud ?? respuesta;

          if (
            !solicitud ||
            typeof solicitud !== "object" ||
            Array.isArray(solicitud)
          ) {
            throw new Error("La API no devolvió una solicitud válida.");
          }

          // Imprimir los datos de la solicitud.
          mostrarValor("solicitud-id", solicitud.id);
          mostrarValor(
            "nombre",
            solicitud.display_name ?? solicitud.nombre
          );
          mostrarValor("roblox", solicitud.roblox_username);
          mostrarValor("correo", solicitud.email);
          mostrarValor("puesto", solicitud.position);
          mostrarValor(
            "experiencia",
            solicitud.experience_level ?? solicitud.experiencia
          );

          mostrarValor(
            "fecha",
            formatearFecha(solicitud.fecha_solicitud)
          );

          mostrarEstado(solicitud.estado);
          contenidoSolicitud.classList.remove("hidden");

          // El examen puede estar en la solicitud o en una propiedad
          // independiente que la API devuelva.
          const examen = respuesta?.examen ?? solicitud.examen ?? null;

          const examenCompletado = obtenerEstadoExamen(
            solicitud,
            examen
          );

          const puntaje = obtenerPuntaje(solicitud, examen);

          if (examenCompletado) {
            // Si ya terminó, NO permitir otro intento desde esta página.
            botonExamen.hidden = true;
            urlExamen = "";

            textoExamen.textContent =
              "Tu examen ya está completado. Aquí puedes consultar la calificación registrada.";

            resultadoExamen.classList.remove("hidden");

            if (puntaje !== undefined) {
              puntajeExamen.textContent = String(puntaje);
              detallePuntaje.textContent =
                "Nota maxima: 40";
            } else {
              puntajeExamen.textContent = "Calificación no disponible";
              detallePuntaje.textContent =
                "La API indica que completaste el examen, pero no ha devuelto tu calificación. Debes comprobar que el endpoint incluya el puntaje guardado.";
            }
          } else {
            // No importa si la solicitud está pendiente, aceptada o rechazada.
            // Si todavía no ha hecho el examen, puede realizarlo.
            resultadoExamen.classList.add("hidden");

            if (!solicitud.position) {
              botonExamen.hidden = true;
              textoExamen.textContent =
                "No se encontró el puesto de tu solicitud. No podemos determinar qué examen debes realizar.";
            } else {
              textoExamen.textContent =
                "Todavía no has completado el examen. Puedes realizarlo ahora, sin esperar la decisión sobre tu solicitud.";

              urlExamen =
                `/contratacion/examen/${encodeURIComponent(
                  String(solicitud.position).trim()
                )}`;

              botonExamen.hidden = false;
            }
          }
        } catch (error) {
          mostrarMensaje(
            error instanceof Error
              ? error.message
              : "Ocurrió un error al consultar tu información.",
            "error"
          );
        } finally {
          estadoCarga.classList.add("hidden");
        }
      }

      botonExamen.addEventListener("click", () => {
        if (urlExamen) {
          window.location.assign(urlExamen);
        }
      });

      consultarSolicitud();
    </script>
  </body>
</html>
