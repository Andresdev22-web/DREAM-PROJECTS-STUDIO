
---
import "../../style/global.css";
import AuthGuard from "../../components/AuthGuard.astro";

const API_URL = "https://dreamprojectsstudioapi.nanadev.online";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Formulario de solicitud para unirte a DREAM PROJECTS STUDIO."
    />
    <title>Solicitud de trabajo | DREAM PROJECTS STUDIO</title>
  </head>

  <body class="min-h-screen bg-[#080808] text-white">
    <AuthGuard />

    <main class="mx-auto w-full max-w-4xl px-4 py-10 sm:px-6 lg:py-16">
      <header class="mb-8">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[#FF1744]">
          DREAM PROJECTS STUDIO
        </p>

        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Solicitud de trabajo
        </h1>

        <p class="mt-3 max-w-2xl text-sm leading-6 text-[#B3B3B3] sm:text-base">
          Cuéntanos sobre ti, tus habilidades y tu disponibilidad para colaborar
          en nuestros proyectos de Roblox.
        </p>
      </header>

      <section
        id="loading-panel"
        class="rounded-2xl border border-[#303030] bg-[#111111] p-6"
        role="status"
      >
        <p class="text-sm text-[#B3B3B3]">
          Comprobando si ya tienes una solicitud...
        </p>
      </section>

      <section
        id="form-panel"
        class="hidden"
      >
        <form
          id="application-form"
          data-api-url={API_URL}
          class="space-y-8"
        >
          <section class="rounded-2xl border border-[#303030] bg-[#111111] p-5 sm:p-7">
            <h2 class="mb-6 text-xl font-semibold">Datos personales</h2>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="display_name" class="mb-2 block text-sm text-[#B3B3B3]">
                  Nombre
                </label>
                <input
                  id="display_name"
                  name="display_name"
                  required
                  autocomplete="name"
                  placeholder="Tu nombre"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none transition focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="roblox_username" class="mb-2 block text-sm text-[#B3B3B3]">
                  Usuario de Roblox
                </label>
                <input
                  id="roblox_username"
                  name="roblox_username"
                  required
                  placeholder="Tu usuario de Roblox"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none transition focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="email" class="mb-2 block text-sm text-[#B3B3B3]">
                  Correo electrónico
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="correo@ejemplo.com"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none transition focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="discord_username" class="mb-2 block text-sm text-[#B3B3B3]">
                  Usuario de Discord
                </label>
                <input
                  id="discord_username"
                  name="discord_username"
                  placeholder="Tu usuario de Discord (opcional)"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none transition focus:border-[#FF1744]"
                />
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-[#303030] bg-[#111111] p-5 sm:p-7">
            <h2 class="mb-6 text-xl font-semibold">Perfil profesional</h2>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="position" class="mb-2 block text-sm text-[#B3B3B3]">
                  Posición principal
                </label>
                <select
                  id="position"
                  name="position"
                  required
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                >
                  <option value="PROGRAMMER">Programador</option>
                  <option value="BUILDER">Builder</option>
                  <option value="MODELER">Modelador</option>
                  <option value="UI_DESIGNER">Diseñador UI</option>
                </select>
              </div>

              <div>
                <label for="secondary_positions" class="mb-2 block text-sm text-[#B3B3B3]">
                  Posiciones secundarias
                </label>
                <input
                  id="secondary_positions"
                  name="secondary_positions"
                  placeholder="Ej. Scripter, Builder"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="experience_level" class="mb-2 block text-sm text-[#B3B3B3]">
                  Nivel de experiencia
                </label>
                <select
                  id="experience_level"
                  name="experience_level"
                  required
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                >
                  <option value="BEGINNER">Principiante</option>
                  <option value="INTERMEDIATE">Intermedio</option>
                  <option value="ADVANCED">Avanzado</option>
                </select>
              </div>

              <div>
                <label for="timezone" class="mb-2 block text-sm text-[#B3B3B3]">
                  Zona horaria
                </label>
                <input
                  id="timezone"
                  name="timezone"
                  placeholder="Ej. America/Bogota"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="weekly_hours" class="mb-2 block text-sm text-[#B3B3B3]">
                  Horas disponibles por semana
                </label>
                <input
                  id="weekly_hours"
                  name="weekly_hours"
                  type="number"
                  min="1"
                  max="168"
                  required
                  placeholder="Ej. 10"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="unavailable_times" class="mb-2 block text-sm text-[#B3B3B3]">
                  Horarios no disponibles
                </label>
                <input
                  id="unavailable_times"
                  name="unavailable_times"
                  placeholder="Ej. Lunes por la mañana"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="tools" class="mb-2 block text-sm text-[#B3B3B3]">
                  Herramientas que utilizas
                </label>
                <input
                  id="tools"
                  name="tools"
                  required
                  placeholder="Ej. Roblox Studio, Lua"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                />
              </div>

              <div>
                <label for="portfolio_url" class="mb-2 block text-sm text-[#B3B3B3]">
                  Portafolio
                </label>
                <input
                  id="portfolio_url"
                  name="portfolio_url"
                  type="url"
                  placeholder="https://ejemplo.com"
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                />
              </div>

              <div class="sm:col-span-2">
                <label for="relevant_experience" class="mb-2 block text-sm text-[#B3B3B3]">
                  Experiencia relevante
                </label>
                <textarea
                  id="relevant_experience"
                  name="relevant_experience"
                  required
                  rows="4"
                  placeholder="Describe tu experiencia y los proyectos en los que has trabajado."
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div class="sm:col-span-2">
                <label for="collaboration_type" class="mb-2 block text-sm text-[#B3B3B3]">
                  Tipo de colaboración
                </label>
                <select
                  id="collaboration_type"
                  name="collaboration_type"
                  required
                  class="w-full rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                >
                  <option value="VOLUNTEER">Voluntariado</option>
                  <option value="PAID">Remunerada</option>
                </select>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-[#303030] bg-[#111111] p-5 sm:p-7">
            <h2 class="mb-6 text-xl font-semibold">Preguntas</h2>

            <div class="space-y-5">
              <div>
                <label for="motivation" class="mb-2 block text-sm text-[#B3B3B3]">
                  ¿Por qué quieres unirte al equipo?
                </label>
                <textarea
                  id="motivation"
                  name="motivation"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div>
                <label for="current_learning" class="mb-2 block text-sm text-[#B3B3B3]">
                  ¿Qué estás aprendiendo actualmente?
                </label>
                <textarea
                  id="current_learning"
                  name="current_learning"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div>
                <label for="deadline_response" class="mb-2 block text-sm text-[#B3B3B3]">
                  ¿Cómo actuarías ante una fecha límite?
                </label>
                <textarea
                  id="deadline_response"
                  name="deadline_response"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div>
                <label for="communication" class="mb-2 block text-sm text-[#B3B3B3]">
                  ¿Cómo mantienes la comunicación con el equipo?
                </label>
                <textarea
                  id="communication"
                  name="communication"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div>
                <label for="feedback_response" class="mb-2 block text-sm text-[#B3B3B3]">
                  ¿Cómo respondes a las críticas y sugerencias?
                </label>
                <textarea
                  id="feedback_response"
                  name="feedback_response"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div>
                <label for="teamwork_example" class="mb-2 block text-sm text-[#B3B3B3]">
                  Describe un ejemplo de trabajo en equipo
                </label>
                <textarea
                  id="teamwork_example"
                  name="teamwork_example"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div>
                <label for="collaboration_conditions" class="mb-2 block text-sm text-[#B3B3B3]">
                  ¿Qué condiciones necesitas para colaborar?
                </label>
                <textarea
                  id="collaboration_conditions"
                  name="collaboration_conditions"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>

              <div>
                <label for="authorship_details" class="mb-2 block text-sm text-[#B3B3B3]">
                  Detalles sobre la autoría de tus trabajos
                </label>
                <textarea
                  id="authorship_details"
                  name="authorship_details"
                  required
                  rows="3"
                  class="w-full resize-y rounded-xl border border-[#303030] bg-[#080808] px-4 py-3 text-white outline-none focus:border-[#FF1744]"
                ></textarea>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-[#303030] bg-[#111111] p-5 sm:p-7">
            <h2 class="mb-5 text-xl font-semibold">Declaraciones</h2>

            <div class="space-y-4">
              <label class="flex cursor-pointer items-start gap-3 text-sm leading-6 text-[#B3B3B3]">
                <input
                  type="checkbox"
                  name="authorship_confirmed"
                  value="true"
                  required
                  class="mt-1 accent-[#FF1744]"
                />
                <span>Confirmo que la información presentada es auténtica y que respeto la autoría de los trabajos que menciono.</span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 text-sm leading-6 text-[#B3B3B3]">
                <input
                  type="checkbox"
                  name="privacy_consent"
                  value="true"
                  required
                  class="mt-1 accent-[#FF1744]"
                />
                <span>Acepto el tratamiento de mis datos para gestionar mi solicitud de ingreso al equipo.</span>
              </label>
            </div>
          </section>

          <button
            id="submit-button"
            type="submit"
            class="w-full rounded-xl bg-[#FF1744] px-6 py-4 font-semibold text-white transition hover:bg-[#D91238] disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
          >
            Enviar solicitud
          </button>
        </form>
      </section>

      <div
        id="form-message"
        role="status"
        aria-live="polite"
        class="mt-6 hidden whitespace-pre-wrap rounded-xl border border-[#303030] bg-[#111111] p-4 text-sm leading-6 text-[#B3B3B3]"
      ></div>
    </main>

    <script>
      const API_URL = document.querySelector<HTMLFormElement>(
        "#application-form",
      )?.dataset.apiUrl;

      const form = document.querySelector<HTMLFormElement>(
        "#application-form",
      );

      const formPanel = document.querySelector<HTMLElement>("#form-panel");
      const loadingPanel = document.querySelector<HTMLElement>("#loading-panel");
      const message = document.querySelector<HTMLElement>("#form-message");
      const submitButton = document.querySelector<HTMLButtonElement>(
        "#submit-button",
      );

      const showMessage = (text: string, isError = false) => {
        if (!message) return;

        message.textContent = text;
        message.classList.remove("hidden");

        message.classList.toggle("border-[#FF1744]", isError);
        message.classList.toggle("text-[#FF8080]", isError);
      };

      const hideLoading = () => {
        loadingPanel?.classList.add("hidden");
      };

      const showForm = () => {
        hideLoading();
        formPanel?.classList.remove("hidden");
      };

      const getToken = () => localStorage.getItem("api_access_token");

      async function checkExistingApplication() {
        const token = getToken();

        if (!API_URL || !form || !formPanel) {
          hideLoading();
          showMessage("No se ha podido configurar el formulario.", true);
          return;
        }

        if (!token) {
          hideLoading();
          showMessage(
            "Necesitas iniciar sesión para consultar o enviar tu solicitud.",
            true,
          );
          return;
        }

        try {
          const response = await fetch(
            `${API_URL.replace(/\/+$/, "")}/solicitudes/mia`,
            {
              method: "GET",
              headers: {
                Authorization: `Bearer ${token}`,
                Accept: "application/json",
              },
            },
          );

          // En esta API, un 404 se interpreta como que aún no hay solicitud.
          if (response.status === 404) {
            showForm();
            return;
          }

          if (response.status === 401 || response.status === 403) {
            hideLoading();
            showMessage(
              "Tu sesión no es válida o no tienes permiso para consultar la solicitud. Inicia sesión nuevamente.",
              true,
            );
            return;
          }

          if (!response.ok) {
            throw new Error(
              `No se pudo consultar tu solicitud. Error HTTP ${response.status}.`,
            );
          }

          const result = await response.json();

          // Admite respuestas directas o respuestas envueltas en "solicitud".
          const application = result?.solicitud ?? result;

          if (
            result?.tiene_solicitud === false ||
            result?.has_application === false ||
            result?.solicitud === null ||
            application === null
          ) {
            showForm();
            return;
          }

          // Ya existe una solicitud: no mostramos el formulario.
          window.location.replace("/contratacion/mi-examen");
        } catch (error) {
          hideLoading();

          showMessage(
            error instanceof Error
              ? error.message
              : "No se pudo comprobar tu solicitud. Inténtalo nuevamente.",
            true,
          );
        }
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!form || !API_URL || !submitButton) return;

        const token = getToken();

        if (!token) {
          showMessage("Tu sesión ha expirado. Inicia sesión nuevamente.", true);
          return;
        }

        const data = new FormData(form);
        const getText = (name: string) =>
          data.get(name)?.toString().trim() ?? "";

        const payload = {
          candidate: {
            display_name: getText("display_name"),
            roblox_username: getText("roblox_username"),
            email: getText("email"),
            discord_username: getText("discord_username") || null,
          },
          profile: {
            position: getText("position"),
            secondary_positions: getText("secondary_positions") || null,
            experience_level: getText("experience_level"),
            timezone: getText("timezone"),
            weekly_hours: Number(getText("weekly_hours")),
            unavailable_times: getText("unavailable_times"),
            tools: getText("tools"),
            portfolio_url: getText("portfolio_url") || null,
            relevant_experience: getText("relevant_experience"),
            collaboration_type: getText("collaboration_type"),
          },
          answers: {
            motivation: getText("motivation"),
            current_learning: getText("current_learning"),
            deadline_response: getText("deadline_response"),
            communication: getText("communication"),
            feedback_response: getText("feedback_response"),
            teamwork_example: getText("teamwork_example"),
            collaboration_conditions: getText("collaboration_conditions"),
            authorship_details: getText("authorship_details"),
          },
          declarations: {
            authorship_confirmed:
              data.get("authorship_confirmed") === "true",
            privacy_consent: data.get("privacy_consent") === "true",
          },
        };

        submitButton.disabled = true;
        showMessage("Enviando tu solicitud...");

        try {
          const response = await fetch(
            `${API_URL.replace(/\/+$/, "")}/solicitudes/`,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${token}`,
                Accept: "application/json",
              },
              body: JSON.stringify(payload),
            },
          );

          const responseText = await response.text();

          let result: any;

          try {
            result = responseText ? JSON.parse(responseText) : null;
          } catch {
            result = responseText;
          }

          if (response.status === 409) {
            showMessage(
              "Ya tienes una solicitud registrada. Te llevaremos a la página de tu solicitud.",
            );

            window.setTimeout(() => {
              window.location.replace("/contratacion/mi-examen");
            }, 1200);

            return;
          }

          if (!response.ok) {
            const details =
              typeof result === "string"
                ? result
                : result?.detail !== undefined
                  ? JSON.stringify(result.detail, null, 2)
                  : JSON.stringify(result, null, 2);

            showMessage(
              `No se pudo enviar la solicitud (HTTP ${response.status}).\n\n${details}`,
              true,
            );

            return;
          }

          showMessage(
            "¡Tu solicitud se ha enviado correctamente! Te llevaremos a la página donde podrás consultar su estado.",
          );

          window.setTimeout(() => {
            window.location.replace("/contratacion/mi-examen");
          }, 1200);
        } catch (error) {
          showMessage(
            `Error de conexión: ${
              error instanceof Error ? error.message : String(error)
            }\n\nComprueba la URL de la API y su configuración CORS.`,
            true,
          );
        } finally {
          submitButton.disabled = false;
        }
      });

      checkExistingApplication();
    </script>
  </body>
</html>
