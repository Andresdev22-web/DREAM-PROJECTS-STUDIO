---
import "../style/global.css"
import { LayoutLandingPage, Header } from 'lity-ui';


const links = [
  { label: "Inicio", href: "/", icon: "🏠" },
  { label: "Componentes", href: "/components", icon: "🧩" },
  { label: "Documentación", href: "/docs", icon: "📚" },
];

---
<LayoutLandingPage titlePage="titulo">

<Header
slot="header"
  title="Lity UI"
  logoIcon="lucide:layers"

  showNavigation={true}
  navigationTitle="Secciones"
  navigationLinks={[
    { label: "Inicio", href: "/", icon: "lucide:house" },
    { label: "Componentes", href: "/components", icon: "lucide:blocks" },
    { label: "Documentación", href: "/docs", icon: "lucide:book-open" },
  ]}

  optionsTitle="Más opciones"
  optionsLinks={[
    { label: "GitHub", href: "https://github.com/Andresdev22-web/lity-ui", icon: "lucide:github" },
    { label: "Contacto", href: "/contact", icon: "lucide:mail" },
  ]}

  showThemeSelector={false}
  sticky={true}
/>


</LayoutLandingPage>