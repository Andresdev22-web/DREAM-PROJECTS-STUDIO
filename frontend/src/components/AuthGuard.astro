
---
interface Props {
  role?: "USUARIO" | "CLIENTE" | "SOLICITANTE" | "TRABAJADOR" | "ADMINISTRADOR";
}

const { role } = Astro.props;
---

<div
  id="auth-guard"
  data-required-role={role ?? ""}
  data-api-url="https://dreamprojectsstudioapi.nanadev.online"
>
  <p id="auth-loading">Verificando sesión...</p>

  <div id="protected-content" hidden>
    <slot />
  </div>
</div>

<script>
  const guard = document.querySelector<HTMLDivElement>("#auth-guard");

  async function protectPage() {
    if (!guard) return;

    const api = guard.dataset.apiUrl!;
    const requiredRole = (guard.dataset.requiredRole ?? "").toUpperCase();
    const token = localStorage.getItem("api_access_token");

    const returnTo =
      location.pathname + location.search + location.hash;

    function redirect(reason: "login" | "role") {
      const params = new URLSearchParams({
        returnTo,
        reason,
      });

      if (requiredRole) {
        params.set("requiredRole", requiredRole);
      }

      location.replace(`/login?${params.toString()}`);
    }

    if (!token) {
      redirect("login");
      return;
    }

    try {
      const response = await fetch(`${api}/auth/me`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (!response.ok) {
        localStorage.removeItem("api_access_token");
        localStorage.removeItem("user_data");
        redirect("login");
        return;
      }

      const user = await response.json();

      // Mantener actualizados los datos del usuario.
      localStorage.setItem("user_data", JSON.stringify(user));

      const actualRole = String(user.rol ?? "").toUpperCase();

      if (requiredRole && actualRole !== requiredRole) {
        redirect("role");
        return;
      }

      document.querySelector("#auth-loading")?.remove();

      const content = guard.querySelector<HTMLDivElement>(
        "#protected-content"
      );

      if (content) content.hidden = false;

      guard.dataset.authorized = "true";

      document.dispatchEvent(
        new CustomEvent("auth:authorized", {
          detail: { user },
        })
      );

    } catch (error) {
      console.error("Error verificando la sesión:", error);

      const loading = document.querySelector("#auth-loading");

      if (loading) {
        loading.textContent = "Error de conexión al verificar la sesión.";
      }
    }
  }

  protectPage();
</script>
